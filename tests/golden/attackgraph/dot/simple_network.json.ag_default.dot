digraph "Simple Network Attack" {
	bgcolor=white fontname=Arial nodesep=0.5 rankdir=LR ranksep=0.8 splines=ortho
	label="Simple Network Attack" labelloc=t
	attacker [label=Attacker fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=attacker margin=0.15 shape=box3d style=filled zone=external]
	webserver [label="Web Server" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=webserver margin=0.15 shape=box3d style=filled zone=dmz]
	appserver [label="Application Server" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=appserver margin=0.15 shape=box3d style=filled zone=internal]
	database [label=Database fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=database margin=0.15 shape=box3d style=filled zone=internal]
	vuln_web_rce [label="Web RCE\n(CVSS: 9.8 - Critical)*" fillcolor="#8b0000" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_web_rce margin=0.1 shape=diamond style=filled]
	vuln_app_sqli [label="SQL Injection\n(CVSS: 8.1 - High)*" fillcolor="#e74c3c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_app_sqli margin=0.1 shape=diamond style=filled]
	vuln_db_default [label="Default Credentials\n(CVSS: 7.5 - High)*" fillcolor="#e74c3c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_db_default margin=0.1 shape=diamond style=filled]
	priv_web_user [label="Web User\n[user]" description="Low privilege shell on web server" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_web_user margin=0.1 shape=ellipse style=filled]
	priv_web_root [label="Web Root\n[root]" description="Root on web server" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_web_root margin=0.1 shape=ellipse style=filled]
	priv_app_access [label="App Access\n[user]" description="Access to application server" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_app_access margin=0.1 shape=ellipse style=filled]
	priv_db_read [label="DB Read\n[user]" description="Read access to database" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_db_read margin=0.1 shape=ellipse style=filled]
	priv_db_admin [label="DB Admin\n[admin]" description="Full database admin access" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_db_admin margin=0.1 shape=ellipse style=filled]
	svc_http [label="HTTP\n:80" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_http margin=0.1 shape=component style=filled]
	svc_api [label="REST API\n:8080" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_api margin=0.1 shape=component style=filled]
	svc_mysql [label="MySQL\n:3306" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_mysql margin=0.1 shape=component style=filled]
	attacker -> webserver [label="Internet Access" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	webserver -> appserver [label="Internal Network" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	appserver -> database [label="DB Connection" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	exploit_web_rce [label="Web RCE Exploit" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	attacker -> exploit_web_rce [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_web_rce -> priv_web_user [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_privesc [label="Privilege Escalation" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_web_user -> exploit_privesc [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_privesc -> priv_web_root [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_pivot [label="Pivot to App Server" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_web_root -> exploit_pivot [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_pivot -> priv_app_access [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_sqli [label="SQL Injection Exploit" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_app_access -> exploit_sqli [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_sqli -> priv_db_read [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_db_default [label="Default Creds" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_app_access -> exploit_db_default [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_db_default -> priv_db_admin [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	webserver -> vuln_web_rce [color="#95a5a6" style=dotted]
	appserver -> vuln_app_sqli [color="#95a5a6" style=dotted]
	database -> vuln_db_default [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	appserver -> svc_api [color="#95a5a6" style=dotted]
	database -> svc_mysql [color="#95a5a6" style=dotted]
}
