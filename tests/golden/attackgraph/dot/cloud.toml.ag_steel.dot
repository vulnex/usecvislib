digraph "Cloud Infrastructure Attack Graph" {
	bgcolor=white fontname=Helvetica nodesep=0.5 rankdir=LR ranksep=0.8 splines=ortho
	label="Cloud Infrastructure Attack Graph" labelloc=t
	attacker [label=Attacker fillcolor="#2B2D42" fontcolor=white fontname=Helvetica fontsize=11 id=attacker margin=0.15 shape=box3d style=filled zone=external]
	waf [label="WAF/CDN" fillcolor="#2B2D42" fontcolor=white fontname=Helvetica fontsize=11 id=waf margin=0.15 shape=box3d style=filled zone="edge"]
	loadbalancer [label="Load Balancer" fillcolor="#2B2D42" fontcolor=white fontname=Helvetica fontsize=11 id=loadbalancer margin=0.15 shape=box3d style=filled zone=dmz]
	webserver [label="Web Server" fillcolor="#2B2D42" fontcolor=white fontname=Helvetica fontsize=11 id=webserver margin=0.15 shape=box3d style=filled zone=web]
	appserver [label="Application Server" fillcolor="#2B2D42" fontcolor=white fontname=Helvetica fontsize=11 id=appserver margin=0.15 shape=box3d style=filled zone=application]
	database [label="RDS Database" fillcolor="#2B2D42" fontcolor=white fontname=Helvetica fontsize=11 id=database margin=0.15 shape=box3d style=filled zone=data]
	secrets [label="Secrets Manager" fillcolor="#2B2D42" fontcolor=white fontname=Helvetica fontsize=11 id=secrets margin=0.15 shape=box3d style=filled zone=secure]
	vuln_waf_bypass [label="WAF Bypass\n(CVSS: 4.8 - Medium)*" fillcolor="#EF233C" fontcolor=white fontname=Helvetica fontsize=10 id=vuln_waf_bypass margin=0.1 shape=diamond style=filled]
	vuln_web_ssrf [label="SSRF Vulnerability\n(CVSS: 9.3 - Critical)*" fillcolor="#EF233C" fontcolor=white fontname=Helvetica fontsize=10 id=vuln_web_ssrf margin=0.1 shape=diamond style=filled]
	vuln_app_rce [label="Remote Code Execution\n(CVSS: 8.8 - High)*" fillcolor="#EF233C" fontcolor=white fontname=Helvetica fontsize=10 id=vuln_app_rce margin=0.1 shape=diamond style=filled]
	vuln_db_sqli [label="SQL Injection\n(CVSS: 8.1 - High)*" fillcolor="#EF233C" fontcolor=white fontname=Helvetica fontsize=10 id=vuln_db_sqli margin=0.1 shape=diamond style=filled]
	vuln_secrets_iam [label="IAM Misconfiguration\n(CVSS: 7.7 - High)*" fillcolor="#EF233C" fontcolor=white fontname=Helvetica fontsize=10 id=vuln_secrets_iam margin=0.1 shape=diamond style=filled]
	priv_waf_access [label="WAF Bypass\n[bypass]" description="Bypass WAF protection" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 id=priv_waf_access margin=0.1 shape=ellipse style=filled]
	priv_web_user [label="Web User Shell\n[user]" description="User-level access on web server" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 id=priv_web_user margin=0.1 shape=ellipse style=filled]
	priv_app_exec [label="Lambda Execution\n[function]" description="Code execution in Lambda" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 id=priv_app_exec margin=0.1 shape=ellipse style=filled]
	priv_db_read [label="Database Read\n[read]" description="Read access to database" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 id=priv_db_read margin=0.1 shape=ellipse style=filled]
	priv_db_admin [label="Database Admin\n[admin]" description="Admin access to database" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 id=priv_db_admin margin=0.1 shape=ellipse style=filled]
	priv_secrets_read [label="Secrets Access\n[read]" description="Read secrets from manager" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 id=priv_secrets_read margin=0.1 shape=ellipse style=filled]
	svc_https [label="HTTPS\n:443" fillcolor="#8D99AE" fontcolor=white fontname=Helvetica fontsize=10 id=svc_https margin=0.1 shape=component style=filled]
	svc_http [label="HTTP\n:80" fillcolor="#8D99AE" fontcolor=white fontname=Helvetica fontsize=10 id=svc_http margin=0.1 shape=component style=filled]
	svc_api [label="REST API\n:443" fillcolor="#8D99AE" fontcolor=white fontname=Helvetica fontsize=10 id=svc_api margin=0.1 shape=component style=filled]
	svc_postgres [label="PostgreSQL\n:5432" fillcolor="#8D99AE" fontcolor=white fontname=Helvetica fontsize=10 id=svc_postgres margin=0.1 shape=component style=filled]
	attacker -> waf [label="Internet Access" color="#ADB5BD" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	waf -> loadbalancer [label="Filtered Traffic" color="#ADB5BD" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	loadbalancer -> webserver [label="Load Balanced" color="#ADB5BD" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	webserver -> appserver [label="API Calls" color="#ADB5BD" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	appserver -> database [label="DB Connection" color="#ADB5BD" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	appserver -> secrets [label="Secrets Access" color="#ADB5BD" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	exploit_waf_bypass [label="WAF Encoding Bypass" color="#EF233C" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 margin=0.1 shape=hexagon style=filled]
	attacker -> exploit_waf_bypass [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_waf_bypass -> priv_waf_access [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_ssrf [label="SSRF to Internal" color="#EF233C" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_waf_access -> exploit_ssrf [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_ssrf -> priv_web_user [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_rce [label="Lambda RCE" color="#EF233C" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_web_user -> exploit_rce [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_rce -> priv_app_exec [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_sqli [label="SQL Injection Attack" color="#EF233C" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_app_exec -> exploit_sqli [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_sqli -> priv_db_read [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_secrets [label="IAM Role Abuse" color="#EF233C" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_app_exec -> exploit_secrets [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_secrets -> priv_secrets_read [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_db_admin [label="Privilege Escalation" color="#EF233C" fillcolor="#FCBF49" fontcolor="#2B2D42" fontname=Helvetica fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_db_read -> exploit_db_admin [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_db_admin -> priv_db_admin [color="#EF233C" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	waf -> vuln_waf_bypass [color="#95a5a6" style=dotted]
	webserver -> vuln_web_ssrf [color="#95a5a6" style=dotted]
	appserver -> vuln_app_rce [color="#95a5a6" style=dotted]
	database -> vuln_db_sqli [color="#95a5a6" style=dotted]
	secrets -> vuln_secrets_iam [color="#95a5a6" style=dotted]
	waf -> svc_https [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	appserver -> svc_api [color="#95a5a6" style=dotted]
	database -> svc_postgres [color="#95a5a6" style=dotted]
}
