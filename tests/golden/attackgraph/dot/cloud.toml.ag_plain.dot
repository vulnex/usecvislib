digraph "Cloud Infrastructure Attack Graph" {
	bgcolor=white fontname=Helvetica rankdir=LR splines=ortho
	label="Cloud Infrastructure Attack Graph" labelloc=t
	attacker [label=Attacker color=black fontcolor=black fontname=Helvetica fontsize=11 id=attacker penwidth=1.5 shape=box style="" zone=external]
	waf [label="WAF/CDN" color=black fontcolor=black fontname=Helvetica fontsize=11 id=waf penwidth=1.5 shape=box style="" zone="edge"]
	loadbalancer [label="Load Balancer" color=black fontcolor=black fontname=Helvetica fontsize=11 id=loadbalancer penwidth=1.5 shape=box style="" zone=dmz]
	webserver [label="Web Server" color=black fontcolor=black fontname=Helvetica fontsize=11 id=webserver penwidth=1.5 shape=box style="" zone=web]
	appserver [label="Application Server" color=black fontcolor=black fontname=Helvetica fontsize=11 id=appserver penwidth=1.5 shape=box style="" zone=application]
	database [label="RDS Database" color=black fontcolor=black fontname=Helvetica fontsize=11 id=database penwidth=1.5 shape=box style="" zone=data]
	secrets [label="Secrets Manager" color=black fontcolor=black fontname=Helvetica fontsize=11 id=secrets penwidth=1.5 shape=box style="" zone=secure]
	vuln_waf_bypass [label="WAF Bypass\n(CVSS: 4.8 - Medium)*" color=black fontcolor=black fontname=Helvetica fontsize=10 id=vuln_waf_bypass penwidth=1.5 shape=diamond style=""]
	vuln_web_ssrf [label="SSRF Vulnerability\n(CVSS: 9.3 - Critical)*" color=black fontcolor=black fontname=Helvetica fontsize=10 id=vuln_web_ssrf penwidth=1.5 peripheries=2 shape=diamond style=""]
	vuln_app_rce [label="Remote Code Execution\n(CVSS: 8.8 - High)*" color=black fontcolor=black fontname=Helvetica fontsize=10 id=vuln_app_rce penwidth=1.5 shape=diamond style=""]
	vuln_db_sqli [label="SQL Injection\n(CVSS: 8.1 - High)*" color=black fontcolor=black fontname=Helvetica fontsize=10 id=vuln_db_sqli penwidth=1.5 shape=diamond style=""]
	vuln_secrets_iam [label="IAM Misconfiguration\n(CVSS: 7.7 - High)*" color=black fontcolor=black fontname=Helvetica fontsize=10 id=vuln_secrets_iam penwidth=1.5 shape=diamond style=""]
	priv_waf_access [label="WAF Bypass\n[bypass]" color=black description="Bypass WAF protection" fontcolor=black fontname=Helvetica fontsize=10 id=priv_waf_access penwidth=1.5 shape=ellipse style=""]
	priv_web_user [label="Web User Shell\n[user]" color=black description="User-level access on web server" fontcolor=black fontname=Helvetica fontsize=10 id=priv_web_user penwidth=1.5 shape=ellipse style=""]
	priv_app_exec [label="Lambda Execution\n[function]" color=black description="Code execution in Lambda" fontcolor=black fontname=Helvetica fontsize=10 id=priv_app_exec penwidth=1.5 shape=ellipse style=""]
	priv_db_read [label="Database Read\n[read]" color=black description="Read access to database" fontcolor=black fontname=Helvetica fontsize=10 id=priv_db_read penwidth=1.5 shape=ellipse style=""]
	priv_db_admin [label="Database Admin\n[admin]" color=black description="Admin access to database" fontcolor=black fontname=Helvetica fontsize=10 id=priv_db_admin penwidth=1.5 shape=ellipse style=""]
	priv_secrets_read [label="Secrets Access\n[read]" color=black description="Read secrets from manager" fontcolor=black fontname=Helvetica fontsize=10 id=priv_secrets_read penwidth=1.5 shape=ellipse style=""]
	svc_https [label="HTTPS\n:443" color=black fontcolor=black fontname=Helvetica fontsize=10 id=svc_https penwidth=1 shape=box style=rounded]
	svc_http [label="HTTP\n:80" color=black fontcolor=black fontname=Helvetica fontsize=10 id=svc_http penwidth=1 shape=box style=rounded]
	svc_api [label="REST API\n:443" color=black fontcolor=black fontname=Helvetica fontsize=10 id=svc_api penwidth=1 shape=box style=rounded]
	svc_postgres [label="PostgreSQL\n:5432" color=black fontcolor=black fontname=Helvetica fontsize=10 id=svc_postgres penwidth=1 shape=box style=rounded]
	attacker -> waf [label="Internet Access" color=black fontname=Helvetica fontsize=9 penwidth=1 style=dashed]
	waf -> loadbalancer [label="Filtered Traffic" color=black fontname=Helvetica fontsize=9 penwidth=1 style=dashed]
	loadbalancer -> webserver [label="Load Balanced" color=black fontname=Helvetica fontsize=9 penwidth=1 style=dashed]
	webserver -> appserver [label="API Calls" color=black fontname=Helvetica fontsize=9 penwidth=1 style=dashed]
	appserver -> database [label="DB Connection" color=black fontname=Helvetica fontsize=9 penwidth=1 style=dashed]
	appserver -> secrets [label="Secrets Access" color=black fontname=Helvetica fontsize=9 penwidth=1 style=dashed]
	exploit_waf_bypass [label="WAF Encoding Bypass" color=black fillcolor="#9b59b6" fontcolor=black fontname=Helvetica fontsize=10 penwidth=1.5 shape=hexagon style=""]
	attacker -> exploit_waf_bypass [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_waf_bypass -> priv_waf_access [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_ssrf [label="SSRF to Internal" color=black fillcolor="#9b59b6" fontcolor=black fontname=Helvetica fontsize=10 penwidth=1.5 shape=hexagon style=""]
	priv_waf_access -> exploit_ssrf [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_ssrf -> priv_web_user [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_rce [label="Lambda RCE" color=black fillcolor="#9b59b6" fontcolor=black fontname=Helvetica fontsize=10 penwidth=1.5 shape=hexagon style=""]
	priv_web_user -> exploit_rce [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_rce -> priv_app_exec [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_sqli [label="SQL Injection Attack" color=black fillcolor="#9b59b6" fontcolor=black fontname=Helvetica fontsize=10 penwidth=1.5 shape=hexagon style=""]
	priv_app_exec -> exploit_sqli [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_sqli -> priv_db_read [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_secrets [label="IAM Role Abuse" color=black fillcolor="#9b59b6" fontcolor=black fontname=Helvetica fontsize=10 penwidth=1.5 shape=hexagon style=""]
	priv_app_exec -> exploit_secrets [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_secrets -> priv_secrets_read [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_db_admin [label="Privilege Escalation" color=black fillcolor="#9b59b6" fontcolor=black fontname=Helvetica fontsize=10 penwidth=1.5 shape=hexagon style=""]
	priv_db_read -> exploit_db_admin [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	exploit_db_admin -> priv_db_admin [color=black fontname=Helvetica fontsize=9 penwidth=1.5 style=bold]
	waf -> vuln_waf_bypass [color="#95a5a6" style=dotted]
	webserver -> vuln_web_ssrf [color="#95a5a6" style=dotted]
	appserver -> vuln_app_rce [color="#95a5a6" style=dotted]
	database -> vuln_db_sqli [color="#95a5a6" style=dotted]
	secrets -> vuln_secrets_iam [color="#95a5a6" style=dotted]
	waf -> svc_https [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	appserver -> svc_api [color="#95a5a6" style=dotted]
	database -> svc_postgres [color="#95a5a6" style=dotted]
}
