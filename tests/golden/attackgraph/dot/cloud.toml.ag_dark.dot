digraph "Cloud Infrastructure Attack Graph" {
	bgcolor="#1a1a2e" fontcolor=white fontname=Arial rankdir=LR splines=ortho
	label="Cloud Infrastructure Attack Graph" labelloc=t
	attacker [label=Attacker color="#4a90d9" fillcolor="#16213e" fontcolor="#eeeeee" fontname=Arial fontsize=11 id=attacker penwidth=2 shape=box3d style=filled zone=external]
	waf [label="WAF/CDN" color="#4a90d9" fillcolor="#16213e" fontcolor="#eeeeee" fontname=Arial fontsize=11 id=waf penwidth=2 shape=box3d style=filled zone="edge"]
	loadbalancer [label="Load Balancer" color="#4a90d9" fillcolor="#16213e" fontcolor="#eeeeee" fontname=Arial fontsize=11 id=loadbalancer penwidth=2 shape=box3d style=filled zone=dmz]
	webserver [label="Web Server" color="#4a90d9" fillcolor="#16213e" fontcolor="#eeeeee" fontname=Arial fontsize=11 id=webserver penwidth=2 shape=box3d style=filled zone=web]
	appserver [label="Application Server" color="#4a90d9" fillcolor="#16213e" fontcolor="#eeeeee" fontname=Arial fontsize=11 id=appserver penwidth=2 shape=box3d style=filled zone=application]
	database [label="RDS Database" color="#4a90d9" fillcolor="#16213e" fontcolor="#eeeeee" fontname=Arial fontsize=11 id=database penwidth=2 shape=box3d style=filled zone=data]
	secrets [label="Secrets Manager" color="#4a90d9" fillcolor="#16213e" fontcolor="#eeeeee" fontname=Arial fontsize=11 id=secrets penwidth=2 shape=box3d style=filled zone=secure]
	vuln_waf_bypass [label="WAF Bypass\n(CVSS: 4.8 - Medium)*" color="#ff6b6b" fillcolor="#24162d" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_waf_bypass penwidth=2 shape=diamond style=filled]
	vuln_web_ssrf [label="SSRF Vulnerability\n(CVSS: 9.3 - Critical)*" color="#ff6b6b" fillcolor="#2d132c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_web_ssrf penwidth=2 peripheries=2 shape=diamond style=filled]
	vuln_app_rce [label="Remote Code Execution\n(CVSS: 8.8 - High)*" color="#ff6b6b" fillcolor="#28152c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_app_rce penwidth=2 shape=diamond style=filled]
	vuln_db_sqli [label="SQL Injection\n(CVSS: 8.1 - High)*" color="#ff6b6b" fillcolor="#28152c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_db_sqli penwidth=2 shape=diamond style=filled]
	vuln_secrets_iam [label="IAM Misconfiguration\n(CVSS: 7.7 - High)*" color="#ff6b6b" fillcolor="#28152c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_secrets_iam penwidth=2 shape=diamond style=filled]
	priv_waf_access [label="WAF Bypass\n[bypass]" color="#feca57" description="Bypass WAF protection" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 id=priv_waf_access penwidth=2 shape=ellipse style=filled]
	priv_web_user [label="Web User Shell\n[user]" color="#feca57" description="User-level access on web server" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 id=priv_web_user penwidth=2 shape=ellipse style=filled]
	priv_app_exec [label="Lambda Execution\n[function]" color="#feca57" description="Code execution in Lambda" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 id=priv_app_exec penwidth=2 shape=ellipse style=filled]
	priv_db_read [label="Database Read\n[read]" color="#feca57" description="Read access to database" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 id=priv_db_read penwidth=2 shape=ellipse style=filled]
	priv_db_admin [label="Database Admin\n[admin]" color="#feca57" description="Admin access to database" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 id=priv_db_admin penwidth=2 shape=ellipse style=filled]
	priv_secrets_read [label="Secrets Access\n[read]" color="#feca57" description="Read secrets from manager" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 id=priv_secrets_read penwidth=2 shape=ellipse style=filled]
	svc_https [label="HTTPS\n:443" color="#5ed98a" fillcolor="#1e3a2c" fontcolor="#5ed98a" fontname=Arial fontsize=10 id=svc_https penwidth=2 shape=component style=filled]
	svc_http [label="HTTP\n:80" color="#5ed98a" fillcolor="#1e3a2c" fontcolor="#5ed98a" fontname=Arial fontsize=10 id=svc_http penwidth=2 shape=component style=filled]
	svc_api [label="REST API\n:443" color="#5ed98a" fillcolor="#1e3a2c" fontcolor="#5ed98a" fontname=Arial fontsize=10 id=svc_api penwidth=2 shape=component style=filled]
	svc_postgres [label="PostgreSQL\n:5432" color="#5ed98a" fillcolor="#1e3a2c" fontcolor="#5ed98a" fontname=Arial fontsize=10 id=svc_postgres penwidth=2 shape=component style=filled]
	attacker -> waf [label="Internet Access" color="#4a90d9" fontcolor="#4a90d9" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	waf -> loadbalancer [label="Filtered Traffic" color="#4a90d9" fontcolor="#4a90d9" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	loadbalancer -> webserver [label="Load Balanced" color="#4a90d9" fontcolor="#4a90d9" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	webserver -> appserver [label="API Calls" color="#4a90d9" fontcolor="#4a90d9" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	appserver -> database [label="DB Connection" color="#4a90d9" fontcolor="#4a90d9" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	appserver -> secrets [label="Secrets Access" color="#4a90d9" fontcolor="#4a90d9" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	exploit_waf_bypass [label="WAF Encoding Bypass" color="#ff6b6b" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 penwidth=2 shape=hexagon style=filled]
	attacker -> exploit_waf_bypass [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_waf_bypass -> priv_waf_access [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_ssrf [label="SSRF to Internal" color="#ff6b6b" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_waf_access -> exploit_ssrf [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_ssrf -> priv_web_user [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_rce [label="Lambda RCE" color="#ff6b6b" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_web_user -> exploit_rce [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_rce -> priv_app_exec [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_sqli [label="SQL Injection Attack" color="#ff6b6b" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_app_exec -> exploit_sqli [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_sqli -> priv_db_read [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_secrets [label="IAM Role Abuse" color="#ff6b6b" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_app_exec -> exploit_secrets [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_secrets -> priv_secrets_read [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_db_admin [label="Privilege Escalation" color="#ff6b6b" fillcolor="#3d2914" fontcolor="#feca57" fontname=Arial fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_db_read -> exploit_db_admin [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	exploit_db_admin -> priv_db_admin [color="#ff6b6b" fontcolor="#ff6b6b" fontname=Arial fontsize=9 penwidth=2.5 style=bold]
	waf -> vuln_waf_bypass [color="#95a5a6" style=dotted]
	webserver -> vuln_web_ssrf [color="#95a5a6" style=dotted]
	appserver -> vuln_app_rce [color="#95a5a6" style=dotted]
	database -> vuln_db_sqli [color="#95a5a6" style=dotted]
	secrets -> vuln_secrets_iam [color="#95a5a6" style=dotted]
	waf -> svc_https [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	appserver -> svc_api [color="#95a5a6" style=dotted]
	database -> svc_postgres [color="#95a5a6" style=dotted]
}
