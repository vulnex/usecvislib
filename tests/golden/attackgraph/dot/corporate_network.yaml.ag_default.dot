digraph "Corporate Network Attack Scenario" {
	bgcolor=white fontname=Arial nodesep=0.5 rankdir=LR ranksep=0.8 splines=ortho
	label="Corporate Network Attack Scenario" labelloc=t
	attacker [label="External Attacker" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=attacker margin=0.15 shape=box3d style=filled zone=external]
	firewall [label="Perimeter Firewall" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=firewall margin=0.15 shape=box3d style=filled zone=dmz]
	webserver [label="Web Server" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=webserver margin=0.15 shape=box3d style=filled zone=dmz]
	mailserver [label="Mail Server" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=mailserver margin=0.15 shape=box3d style=filled zone=dmz]
	workstation1 [label="User Workstation" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=workstation1 margin=0.15 shape=box3d style=filled zone=internal]
	dbserver [label="Database Server" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=dbserver margin=0.15 shape=box3d style=filled zone=internal]
	adserver [label="Active Directory" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=adserver margin=0.15 shape=box3d style=filled zone=internal]
	fileserver [label="File Server" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=fileserver margin=0.15 shape=box3d style=filled zone=internal]
	vuln_rce_web [label="Web App RCE\n(CVSS: 9.8 - Critical)*" cve="CVE-2023-XXXX" fillcolor="#8b0000" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_rce_web margin=0.1 shape=diamond style=filled]
	vuln_sqli [label="SQL Injection\n(CVSS: 9.1 - Critical)*" cve="CVE-2023-YYYY" fillcolor="#8b0000" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_sqli margin=0.1 shape=diamond style=filled]
	vuln_phishing [label="Phishing Vulnerability\n(CVSS: 7.5 - High)" fillcolor="#e74c3c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_phishing margin=0.1 shape=diamond style=filled]
	vuln_eternalblue [label="SMB Vulnerability\n(CVSS: 9.0 - Critical)*" cve="CVE-2017-0144" fillcolor="#8b0000" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_eternalblue margin=0.1 shape=diamond style=filled]
	vuln_zerologon [label="Zerologon\n(CVSS: 10.0 - Critical)*" cve="CVE-2020-1472" fillcolor="#8b0000" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_zerologon margin=0.1 shape=diamond style=filled]
	vuln_db_misconfig [label="DB Misconfiguration\n(CVSS: 7.2 - High)" fillcolor="#e74c3c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_db_misconfig margin=0.1 shape=diamond style=filled]
	priv_web_shell [label="Web Shell Access\n[user]" description="Command execution on web server" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_web_shell margin=0.1 shape=ellipse style=filled]
	priv_web_root [label="Web Server Root\n[root]" description="Root access on web server" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_web_root margin=0.1 shape=ellipse style=filled]
	priv_user_access [label="User Workstation Access\n[user]" description="Access to user workstation" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_user_access margin=0.1 shape=ellipse style=filled]
	priv_domain_user [label="Domain User\n[user]" description="Active Directory domain user" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_domain_user margin=0.1 shape=ellipse style=filled]
	priv_domain_admin [label="Domain Admin\n[admin]" description="Full domain administrator" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_domain_admin margin=0.1 shape=ellipse style=filled]
	priv_db_access [label="Database Access\n[user]" description="Access to database server" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_db_access margin=0.1 shape=ellipse style=filled]
	priv_db_admin [label="Database Admin\n[admin]" description="DBA privileges" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_db_admin margin=0.1 shape=ellipse style=filled]
	svc_http [label="HTTP/HTTPS\n:443" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_http margin=0.1 shape=component style=filled]
	svc_smtp [label="SMTP\n:25" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_smtp margin=0.1 shape=component style=filled]
	svc_smb [label="SMB\n:445" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_smb margin=0.1 shape=component style=filled]
	svc_ldap [label="LDAP\n:389" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_ldap margin=0.1 shape=component style=filled]
	svc_mssql [label="MSSQL\n:1433" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_mssql margin=0.1 shape=component style=filled]
	attacker -> webserver [label="Internet Access" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	attacker -> mailserver [label="Internet Access" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	webserver -> dbserver [label="App to DB" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	workstation1 -> adserver [label="Domain Member" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	workstation1 -> fileserver [label="File Access" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	adserver -> dbserver [label="Domain Trust" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	exploit_web_rce [label="Exploit Web RCE" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	attacker -> exploit_web_rce [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_web_rce -> priv_web_shell [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_sqli [label="Exploit SQLi" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	attacker -> exploit_sqli [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_sqli -> priv_db_access [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_privesc_web [label="Local Privilege Escalation" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_web_shell -> exploit_privesc_web [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_privesc_web -> priv_web_root [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_phishing [label="Phishing Attack" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	attacker -> exploit_phishing [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_phishing -> priv_user_access [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_eternalblue [label="EternalBlue Exploit" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_domain_user -> exploit_eternalblue [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_eternalblue -> priv_domain_admin [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_zerologon [label="Zerologon Exploit" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_user_access -> exploit_zerologon [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_zerologon -> priv_domain_admin [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_db_misconfig [label="Database Compromise" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_domain_user -> exploit_db_misconfig [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_db_misconfig -> priv_db_admin [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_lateral_ad [label="AD Credential Theft" fillcolor="#9b59b6" fontcolor=white fontname=Arial fontsize=10 margin=0.1 shape=hexagon style=filled]
	priv_domain_admin -> exploit_lateral_ad [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_lateral_ad -> priv_db_admin [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	webserver -> vuln_rce_web [color="#95a5a6" style=dotted]
	webserver -> vuln_sqli [color="#95a5a6" style=dotted]
	workstation1 -> vuln_phishing [color="#95a5a6" style=dotted]
	fileserver -> vuln_eternalblue [color="#95a5a6" style=dotted]
	adserver -> vuln_zerologon [color="#95a5a6" style=dotted]
	dbserver -> vuln_db_misconfig [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	mailserver -> svc_smtp [color="#95a5a6" style=dotted]
	fileserver -> svc_smb [color="#95a5a6" style=dotted]
	adserver -> svc_ldap [color="#95a5a6" style=dotted]
	dbserver -> svc_mssql [color="#95a5a6" style=dotted]
}
