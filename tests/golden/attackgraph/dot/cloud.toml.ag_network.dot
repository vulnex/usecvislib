digraph "Cloud Infrastructure Attack Graph" {
	bgcolor=white fontname=Helvetica nodesep=0.8 rankdir=TB ranksep=1.0 splines=polyline
	label="Cloud Infrastructure Attack Graph" labelloc=t
	attacker [label=Attacker color="#1a5276" fillcolor="#e8f4f8" fontcolor="#1a5276" fontname=Helvetica fontsize=11 id=attacker penwidth=2 shape=box style="filled,rounded" zone=external]
	waf [label="WAF/CDN" color="#1a5276" fillcolor="#e8f4f8" fontcolor="#1a5276" fontname=Helvetica fontsize=11 id=waf penwidth=2 shape=box style="filled,rounded" zone="edge"]
	loadbalancer [label="Load Balancer" color="#1a5276" fillcolor="#e8f4f8" fontcolor="#1a5276" fontname=Helvetica fontsize=11 id=loadbalancer penwidth=2 shape=box style="filled,rounded" zone=dmz]
	webserver [label="Web Server" color="#1a5276" fillcolor="#e8f4f8" fontcolor="#1a5276" fontname=Helvetica fontsize=11 id=webserver penwidth=2 shape=box style="filled,rounded" zone=web]
	appserver [label="Application Server" color="#1a5276" fillcolor="#e8f4f8" fontcolor="#1a5276" fontname=Helvetica fontsize=11 id=appserver penwidth=2 shape=box style="filled,rounded" zone=application]
	database [label="RDS Database" color="#1a5276" fillcolor="#e8f4f8" fontcolor="#1a5276" fontname=Helvetica fontsize=11 id=database penwidth=2 shape=box style="filled,rounded" zone=data]
	secrets [label="Secrets Manager" color="#1a5276" fillcolor="#e8f4f8" fontcolor="#1a5276" fontname=Helvetica fontsize=11 id=secrets penwidth=2 shape=box style="filled,rounded" zone=secure]
	vuln_waf_bypass [label="WAF Bypass\n(CVSS: 4.8 - Medium)*" color="#922b21" fillcolor="#fdedec" fontcolor="#922b21" fontname=Helvetica fontsize=10 id=vuln_waf_bypass penwidth=2 shape=house style=filled]
	vuln_web_ssrf [label="SSRF Vulnerability\n(CVSS: 9.3 - Critical)*" color="#922b21" fillcolor="#fdedec" fontcolor="#922b21" fontname=Helvetica fontsize=10 id=vuln_web_ssrf penwidth=2 shape=house style=filled]
	vuln_app_rce [label="Remote Code Execution\n(CVSS: 8.8 - High)*" color="#922b21" fillcolor="#fdedec" fontcolor="#922b21" fontname=Helvetica fontsize=10 id=vuln_app_rce penwidth=2 shape=house style=filled]
	vuln_db_sqli [label="SQL Injection\n(CVSS: 8.1 - High)*" color="#922b21" fillcolor="#fdedec" fontcolor="#922b21" fontname=Helvetica fontsize=10 id=vuln_db_sqli penwidth=2 shape=house style=filled]
	vuln_secrets_iam [label="IAM Misconfiguration\n(CVSS: 7.7 - High)*" color="#922b21" fillcolor="#fdedec" fontcolor="#922b21" fontname=Helvetica fontsize=10 id=vuln_secrets_iam penwidth=2 shape=house style=filled]
	priv_waf_access [label="WAF Bypass\n[bypass]" color="#9a7d0a" description="Bypass WAF protection" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 id=priv_waf_access penwidth=2 peripheries=2 shape=ellipse style=filled]
	priv_web_user [label="Web User Shell\n[user]" color="#9a7d0a" description="User-level access on web server" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 id=priv_web_user penwidth=2 peripheries=2 shape=ellipse style=filled]
	priv_app_exec [label="Lambda Execution\n[function]" color="#9a7d0a" description="Code execution in Lambda" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 id=priv_app_exec penwidth=2 peripheries=2 shape=ellipse style=filled]
	priv_db_read [label="Database Read\n[read]" color="#9a7d0a" description="Read access to database" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 id=priv_db_read penwidth=2 peripheries=2 shape=ellipse style=filled]
	priv_db_admin [label="Database Admin\n[admin]" color="#9a7d0a" description="Admin access to database" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 id=priv_db_admin penwidth=2 peripheries=2 shape=ellipse style=filled]
	priv_secrets_read [label="Secrets Access\n[read]" color="#9a7d0a" description="Read secrets from manager" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 id=priv_secrets_read penwidth=2 peripheries=2 shape=ellipse style=filled]
	svc_https [label="HTTPS\n:443" color="#196f3d" fillcolor="#eafaf1" fontcolor="#196f3d" fontname=Helvetica fontsize=10 id=svc_https penwidth=1 shape=rect style="filled,rounded"]
	svc_http [label="HTTP\n:80" color="#196f3d" fillcolor="#eafaf1" fontcolor="#196f3d" fontname=Helvetica fontsize=10 id=svc_http penwidth=1 shape=rect style="filled,rounded"]
	svc_api [label="REST API\n:443" color="#196f3d" fillcolor="#eafaf1" fontcolor="#196f3d" fontname=Helvetica fontsize=10 id=svc_api penwidth=1 shape=rect style="filled,rounded"]
	svc_postgres [label="PostgreSQL\n:5432" color="#196f3d" fillcolor="#eafaf1" fontcolor="#196f3d" fontname=Helvetica fontsize=10 id=svc_postgres penwidth=1 shape=rect style="filled,rounded"]
	attacker -> waf [label="Internet Access" arrowhead=vee color="#2980b9" fontname=Helvetica fontsize=9 penwidth=2 style=solid]
	waf -> loadbalancer [label="Filtered Traffic" arrowhead=vee color="#2980b9" fontname=Helvetica fontsize=9 penwidth=2 style=solid]
	loadbalancer -> webserver [label="Load Balanced" arrowhead=vee color="#2980b9" fontname=Helvetica fontsize=9 penwidth=2 style=solid]
	webserver -> appserver [label="API Calls" arrowhead=vee color="#2980b9" fontname=Helvetica fontsize=9 penwidth=2 style=solid]
	appserver -> database [label="DB Connection" arrowhead=vee color="#2980b9" fontname=Helvetica fontsize=9 penwidth=2 style=solid]
	appserver -> secrets [label="Secrets Access" arrowhead=vee color="#2980b9" fontname=Helvetica fontsize=9 penwidth=2 style=solid]
	exploit_waf_bypass [label="WAF Encoding Bypass" color="#e74c3c" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 penwidth=2 peripheries=2 shape=hexagon style=filled]
	attacker -> exploit_waf_bypass [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_waf_bypass -> priv_waf_access [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_ssrf [label="SSRF to Internal" color="#e74c3c" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 penwidth=2 peripheries=2 shape=hexagon style=filled]
	priv_waf_access -> exploit_ssrf [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_ssrf -> priv_web_user [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_rce [label="Lambda RCE" color="#e74c3c" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 penwidth=2 peripheries=2 shape=hexagon style=filled]
	priv_web_user -> exploit_rce [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_rce -> priv_app_exec [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_sqli [label="SQL Injection Attack" color="#e74c3c" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 penwidth=2 peripheries=2 shape=hexagon style=filled]
	priv_app_exec -> exploit_sqli [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_sqli -> priv_db_read [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_secrets [label="IAM Role Abuse" color="#e74c3c" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 penwidth=2 peripheries=2 shape=hexagon style=filled]
	priv_app_exec -> exploit_secrets [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_secrets -> priv_secrets_read [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_db_admin [label="Privilege Escalation" color="#e74c3c" fillcolor="#fef9e7" fontcolor="#9a7d0a" fontname=Helvetica fontsize=10 penwidth=2 peripheries=2 shape=hexagon style=filled]
	priv_db_read -> exploit_db_admin [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	exploit_db_admin -> priv_db_admin [arrowhead=vee color="#e74c3c" fontname=Helvetica fontsize=9 penwidth=2 style=bold]
	waf -> vuln_waf_bypass [color="#95a5a6" style=dotted]
	webserver -> vuln_web_ssrf [color="#95a5a6" style=dotted]
	appserver -> vuln_app_rce [color="#95a5a6" style=dotted]
	database -> vuln_db_sqli [color="#95a5a6" style=dotted]
	secrets -> vuln_secrets_iam [color="#95a5a6" style=dotted]
	waf -> svc_https [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	appserver -> svc_api [color="#95a5a6" style=dotted]
	database -> svc_postgres [color="#95a5a6" style=dotted]
}
