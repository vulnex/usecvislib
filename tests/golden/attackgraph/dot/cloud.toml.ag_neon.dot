digraph "Cloud Infrastructure Attack Graph" {
	bgcolor="#0d0d0d" fontcolor="#00ff9f" fontname=Consolas rankdir=LR splines=ortho
	label="Cloud Infrastructure Attack Graph" labelloc=t
	attacker [label=Attacker color="#00ff9f" fillcolor="#1a1a2e" fontcolor="#00ff9f" fontname=Consolas fontsize=11 id=attacker penwidth=2 shape=box3d style=filled zone=external]
	waf [label="WAF/CDN" color="#00ff9f" fillcolor="#1a1a2e" fontcolor="#00ff9f" fontname=Consolas fontsize=11 id=waf penwidth=2 shape=box3d style=filled zone="edge"]
	loadbalancer [label="Load Balancer" color="#00ff9f" fillcolor="#1a1a2e" fontcolor="#00ff9f" fontname=Consolas fontsize=11 id=loadbalancer penwidth=2 shape=box3d style=filled zone=dmz]
	webserver [label="Web Server" color="#00ff9f" fillcolor="#1a1a2e" fontcolor="#00ff9f" fontname=Consolas fontsize=11 id=webserver penwidth=2 shape=box3d style=filled zone=web]
	appserver [label="Application Server" color="#00ff9f" fillcolor="#1a1a2e" fontcolor="#00ff9f" fontname=Consolas fontsize=11 id=appserver penwidth=2 shape=box3d style=filled zone=application]
	database [label="RDS Database" color="#00ff9f" fillcolor="#1a1a2e" fontcolor="#00ff9f" fontname=Consolas fontsize=11 id=database penwidth=2 shape=box3d style=filled zone=data]
	secrets [label="Secrets Manager" color="#00ff9f" fillcolor="#1a1a2e" fontcolor="#00ff9f" fontname=Consolas fontsize=11 id=secrets penwidth=2 shape=box3d style=filled zone=secure]
	vuln_waf_bypass [label="WAF Bypass\n(CVSS: 4.8 - Medium)*" color="#ff0080" fillcolor="#14141e" fontcolor="#ffffff" fontname=Consolas fontsize=10 id=vuln_waf_bypass penwidth=2 shape=diamond style=filled]
	vuln_web_ssrf [label="SSRF Vulnerability\n(CVSS: 9.3 - Critical)*" color="#ff0080" fillcolor="#1a1a2e" fontcolor="#ffffff" fontname=Consolas fontsize=10 id=vuln_web_ssrf penwidth=2 peripheries=2 shape=diamond style=filled]
	vuln_app_rce [label="Remote Code Execution\n(CVSS: 8.8 - High)*" color="#ff0080" fillcolor="#171726" fontcolor="#ffffff" fontname=Consolas fontsize=10 id=vuln_app_rce penwidth=2 shape=diamond style=filled]
	vuln_db_sqli [label="SQL Injection\n(CVSS: 8.1 - High)*" color="#ff0080" fillcolor="#171726" fontcolor="#ffffff" fontname=Consolas fontsize=10 id=vuln_db_sqli penwidth=2 shape=diamond style=filled]
	vuln_secrets_iam [label="IAM Misconfiguration\n(CVSS: 7.7 - High)*" color="#ff0080" fillcolor="#171726" fontcolor="#ffffff" fontname=Consolas fontsize=10 id=vuln_secrets_iam penwidth=2 shape=diamond style=filled]
	priv_waf_access [label="WAF Bypass\n[bypass]" color="#ffff00" description="Bypass WAF protection" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 id=priv_waf_access penwidth=2 shape=ellipse style=filled]
	priv_web_user [label="Web User Shell\n[user]" color="#ffff00" description="User-level access on web server" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 id=priv_web_user penwidth=2 shape=ellipse style=filled]
	priv_app_exec [label="Lambda Execution\n[function]" color="#ffff00" description="Code execution in Lambda" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 id=priv_app_exec penwidth=2 shape=ellipse style=filled]
	priv_db_read [label="Database Read\n[read]" color="#ffff00" description="Read access to database" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 id=priv_db_read penwidth=2 shape=ellipse style=filled]
	priv_db_admin [label="Database Admin\n[admin]" color="#ffff00" description="Admin access to database" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 id=priv_db_admin penwidth=2 shape=ellipse style=filled]
	priv_secrets_read [label="Secrets Access\n[read]" color="#ffff00" description="Read secrets from manager" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 id=priv_secrets_read penwidth=2 shape=ellipse style=filled]
	svc_https [label="HTTPS\n:443" color="#00d4ff" fillcolor="#1a1a2e" fontcolor="#00d4ff" fontname=Consolas fontsize=10 id=svc_https penwidth=2 shape=component style=filled]
	svc_http [label="HTTP\n:80" color="#00d4ff" fillcolor="#1a1a2e" fontcolor="#00d4ff" fontname=Consolas fontsize=10 id=svc_http penwidth=2 shape=component style=filled]
	svc_api [label="REST API\n:443" color="#00d4ff" fillcolor="#1a1a2e" fontcolor="#00d4ff" fontname=Consolas fontsize=10 id=svc_api penwidth=2 shape=component style=filled]
	svc_postgres [label="PostgreSQL\n:5432" color="#00d4ff" fillcolor="#1a1a2e" fontcolor="#00d4ff" fontname=Consolas fontsize=10 id=svc_postgres penwidth=2 shape=component style=filled]
	attacker -> waf [label="Internet Access" color="#00d4ff" fontcolor="#00d4ff" fontname=Consolas fontsize=9 penwidth=2 style=dashed]
	waf -> loadbalancer [label="Filtered Traffic" color="#00d4ff" fontcolor="#00d4ff" fontname=Consolas fontsize=9 penwidth=2 style=dashed]
	loadbalancer -> webserver [label="Load Balanced" color="#00d4ff" fontcolor="#00d4ff" fontname=Consolas fontsize=9 penwidth=2 style=dashed]
	webserver -> appserver [label="API Calls" color="#00d4ff" fontcolor="#00d4ff" fontname=Consolas fontsize=9 penwidth=2 style=dashed]
	appserver -> database [label="DB Connection" color="#00d4ff" fontcolor="#00d4ff" fontname=Consolas fontsize=9 penwidth=2 style=dashed]
	appserver -> secrets [label="Secrets Access" color="#00d4ff" fontcolor="#00d4ff" fontname=Consolas fontsize=9 penwidth=2 style=dashed]
	exploit_waf_bypass [label="WAF Encoding Bypass" color="#ff0080" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 penwidth=2 shape=hexagon style=filled]
	attacker -> exploit_waf_bypass [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_waf_bypass -> priv_waf_access [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_ssrf [label="SSRF to Internal" color="#ff0080" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_waf_access -> exploit_ssrf [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_ssrf -> priv_web_user [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_rce [label="Lambda RCE" color="#ff0080" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_web_user -> exploit_rce [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_rce -> priv_app_exec [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_sqli [label="SQL Injection Attack" color="#ff0080" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_app_exec -> exploit_sqli [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_sqli -> priv_db_read [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_secrets [label="IAM Role Abuse" color="#ff0080" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_app_exec -> exploit_secrets [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_secrets -> priv_secrets_read [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_db_admin [label="Privilege Escalation" color="#ff0080" fillcolor="#1a1a2e" fontcolor="#ffff00" fontname=Consolas fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_db_read -> exploit_db_admin [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	exploit_db_admin -> priv_db_admin [color="#ff0080" fontcolor="#ff0080" fontname=Consolas fontsize=9 penwidth=3 style=bold]
	waf -> vuln_waf_bypass [color="#95a5a6" style=dotted]
	webserver -> vuln_web_ssrf [color="#95a5a6" style=dotted]
	appserver -> vuln_app_rce [color="#95a5a6" style=dotted]
	database -> vuln_db_sqli [color="#95a5a6" style=dotted]
	secrets -> vuln_secrets_iam [color="#95a5a6" style=dotted]
	waf -> svc_https [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	appserver -> svc_api [color="#95a5a6" style=dotted]
	database -> svc_postgres [color="#95a5a6" style=dotted]
}
