digraph "Cloud Infrastructure Attack Scenario" {
	bgcolor=white fontname=Arial nodesep=0.5 rankdir=LR ranksep=0.8 splines=ortho
	label="Cloud Infrastructure Attack Scenario" labelloc=t
	attacker [label="External Attacker" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=attacker margin=0.15 shape=box3d style=filled zone=internet]
	cdn [label="CloudFront CDN" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=cdn margin=0.15 shape=box3d style=filled zone="edge"]
	alb [label="Application LB" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=alb margin=0.15 shape=box3d style=filled zone=public]
	api_gateway [label="API Gateway" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=api_gateway margin=0.15 shape=box3d style=filled zone=public]
	auth_service [label="Auth Service" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=auth_service margin=0.15 shape=box3d style=filled zone=private]
	user_service [label="User Service" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=user_service margin=0.15 shape=box3d style=filled zone=private]
	payment_service [label="Payment Service" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=payment_service margin=0.15 shape=box3d style=filled zone=private]
	rds_primary [label="RDS Primary" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=rds_primary margin=0.15 shape=box3d style=filled zone=data]
	redis_cluster [label="Redis Cluster" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=redis_cluster margin=0.15 shape=box3d style=filled zone=data]
	s3_bucket [label="S3 Bucket" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=s3_bucket margin=0.15 shape=box3d style=filled zone=data]
	secrets_manager [label="Secrets Manager" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=secrets_manager margin=0.15 shape=box3d style=filled zone=management]
	eks_control [label="EKS Control Plane" fillcolor="#4a90d9" fontcolor=white fontname=Arial fontsize=11 id=eks_control margin=0.15 shape=box3d style=filled zone=management]
	vuln_ssrf [label="SSRF Vulnerability\n(CVSS: 9.3 - Critical)*" fillcolor="#8b0000" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_ssrf margin=0.1 shape=diamond style=filled]
	vuln_jwt_weak [label="Weak JWT Secret\n(CVSS: 7.5 - High)*" fillcolor="#e74c3c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_jwt_weak margin=0.1 shape=diamond style=filled]
	vuln_log4j [label="Log4Shell\n(CVSS: 10.0 - Critical)*" cve="CVE-2021-44228" fillcolor="#8b0000" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_log4j margin=0.1 shape=diamond style=filled]
	vuln_idor [label="IDOR\n(CVSS: 6.5 - Medium)*" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=vuln_idor margin=0.1 shape=diamond style=filled]
	vuln_s3_public [label="S3 Misconfiguration\n(CVSS: 7.5 - High)*" fillcolor="#e74c3c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_s3_public margin=0.1 shape=diamond style=filled]
	vuln_imds [label="IMDS Exposure\n(CVSS: 8.1 - High)*" fillcolor="#e74c3c" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_imds margin=0.1 shape=diamond style=filled]
	vuln_k8s_api [label="K8s API Exposed\n(CVSS: 9.8 - Critical)*" fillcolor="#8b0000" fontcolor="#ffffff" fontname=Arial fontsize=10 id=vuln_k8s_api margin=0.1 shape=diamond style=filled]
	priv_api_access [label="API Access\n[user]" description="Authenticated API access" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_api_access margin=0.1 shape=ellipse style=filled]
	priv_jwt_forge [label="JWT Forgery\n[elevated]" description="Ability to forge JWT tokens" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_jwt_forge margin=0.1 shape=ellipse style=filled]
	priv_user_svc_rce [label="User Service RCE\n[container]" description="Code execution on user service" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_user_svc_rce margin=0.1 shape=ellipse style=filled]
	priv_payment_rce [label="Payment Service RCE\n[container]" description="Code execution on payment service" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_payment_rce margin=0.1 shape=ellipse style=filled]
	priv_aws_role [label="AWS IAM Role\n[cloud]" description="Assumed IAM role from IMDS" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_aws_role margin=0.1 shape=ellipse style=filled]
	priv_secrets_read [label="Secrets Read\n[cloud]" description="Read access to Secrets Manager" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_secrets_read margin=0.1 shape=ellipse style=filled]
	priv_db_access [label="Database Access\n[data]" description="Direct database access" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_db_access margin=0.1 shape=ellipse style=filled]
	priv_s3_read [label="S3 Read Access\n[data]" description="Read access to S3 bucket" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_s3_read margin=0.1 shape=ellipse style=filled]
	priv_k8s_admin [label="K8s Admin\n[admin]" description="Kubernetes cluster admin" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_k8s_admin margin=0.1 shape=ellipse style=filled]
	priv_cluster_escape [label="Cluster Escape\n[node]" description="Escaped container to node" fillcolor="#f39c12" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_cluster_escape margin=0.1 shape=ellipse style=filled]
	svc_https [label="HTTPS\n:443" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_https margin=0.1 shape=component style=filled]
	svc_api [label="REST API\n:8080" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_api margin=0.1 shape=component style=filled]
	svc_grpc [label="gRPC\n:50051" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_grpc margin=0.1 shape=component style=filled]
	svc_postgres [label="PostgreSQL\n:5432" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_postgres margin=0.1 shape=component style=filled]
	svc_redis [label="Redis\n:6379" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_redis margin=0.1 shape=component style=filled]
	svc_k8s [label="K8s API\n:6443" fillcolor="#27ae60" fontcolor=white fontname=Arial fontsize=10 id=svc_k8s margin=0.1 shape=component style=filled]
	attacker -> cdn [label=Internet color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	cdn -> alb [label="Edge to LB" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	alb -> api_gateway [label="LB to API" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	api_gateway -> auth_service [label="API to Auth" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	api_gateway -> user_service [label="API to Users" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	api_gateway -> payment_service [label="API to Payment" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	auth_service -> redis_cluster [label="Session Store" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	user_service -> rds_primary [label="DB Connection" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	payment_service -> rds_primary [label="DB Connection" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	payment_service -> secrets_manager [label="Secrets Access" color="#3498db" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	exploit_ssrf_imds [label="SSRF to IMDS" fillcolor="#9b59b6" fontcolor=white shape=hexagon style=filled]
	attacker -> exploit_ssrf_imds [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_ssrf_imds -> priv_aws_role [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_jwt_crack [label="JWT Key Crack" fillcolor="#9b59b6" fontcolor=white shape=hexagon style=filled]
	priv_api_access -> exploit_jwt_crack [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_jwt_crack -> priv_jwt_forge [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_log4shell [label="Log4Shell RCE" fillcolor="#9b59b6" fontcolor=white shape=hexagon style=filled]
	attacker -> exploit_log4shell [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_log4shell -> priv_user_svc_rce [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_imds [label="IMDS Credential Theft" fillcolor="#9b59b6" fontcolor=white shape=hexagon style=filled]
	priv_payment_rce -> exploit_imds [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_imds -> priv_aws_role [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_s3_public [label="S3 Data Exfil" fillcolor="#9b59b6" fontcolor=white shape=hexagon style=filled]
	attacker -> exploit_s3_public [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_s3_public -> priv_s3_read [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_k8s_api [label="K8s API Access" fillcolor="#9b59b6" fontcolor=white shape=hexagon style=filled]
	priv_user_svc_rce -> exploit_k8s_api [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_k8s_api -> priv_k8s_admin [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_secrets [label="Secrets Exfil" fillcolor="#9b59b6" fontcolor=white shape=hexagon style=filled]
	priv_aws_role -> exploit_secrets [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_secrets -> priv_secrets_read [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_db_creds [label="DB Credential Use" fillcolor="#9b59b6" fontcolor=white shape=hexagon style=filled]
	priv_secrets_read -> exploit_db_creds [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_db_creds -> priv_db_access [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_container_escape [label="Container Escape" fillcolor="#9b59b6" fontcolor=white shape=hexagon style=filled]
	priv_k8s_admin -> exploit_container_escape [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_container_escape -> priv_cluster_escape [color="#e74c3c" fontname=Arial fontsize=9 penwidth=2 style=bold]
	api_gateway -> vuln_ssrf [color="#95a5a6" style=dotted]
	auth_service -> vuln_jwt_weak [color="#95a5a6" style=dotted]
	user_service -> vuln_log4j [color="#95a5a6" style=dotted]
	user_service -> vuln_idor [color="#95a5a6" style=dotted]
	s3_bucket -> vuln_s3_public [color="#95a5a6" style=dotted]
	payment_service -> vuln_imds [color="#95a5a6" style=dotted]
	eks_control -> vuln_k8s_api [color="#95a5a6" style=dotted]
	alb -> svc_https [color="#95a5a6" style=dotted]
	api_gateway -> svc_api [color="#95a5a6" style=dotted]
	auth_service -> svc_grpc [color="#95a5a6" style=dotted]
	rds_primary -> svc_postgres [color="#95a5a6" style=dotted]
	redis_cluster -> svc_redis [color="#95a5a6" style=dotted]
	eks_control -> svc_k8s [color="#95a5a6" style=dotted]
}
