digraph "Cloud Infrastructure Attack Graph" {
	bgcolor="#1A1025" fontcolor="#E0AAFF" fontname=Helvetica nodesep=0.5 rankdir=LR ranksep=0.8 splines=ortho
	label="Cloud Infrastructure Attack Graph" labelloc=t
	attacker [label=Attacker color="#7B2CBF" fillcolor="#240046" fontcolor="#E0AAFF" fontname=Helvetica fontsize=11 id=attacker penwidth=2 shape=box3d style=filled zone=external]
	waf [label="WAF/CDN" color="#7B2CBF" fillcolor="#240046" fontcolor="#E0AAFF" fontname=Helvetica fontsize=11 id=waf penwidth=2 shape=box3d style=filled zone="edge"]
	loadbalancer [label="Load Balancer" color="#7B2CBF" fillcolor="#240046" fontcolor="#E0AAFF" fontname=Helvetica fontsize=11 id=loadbalancer penwidth=2 shape=box3d style=filled zone=dmz]
	webserver [label="Web Server" color="#7B2CBF" fillcolor="#240046" fontcolor="#E0AAFF" fontname=Helvetica fontsize=11 id=webserver penwidth=2 shape=box3d style=filled zone=web]
	appserver [label="Application Server" color="#7B2CBF" fillcolor="#240046" fontcolor="#E0AAFF" fontname=Helvetica fontsize=11 id=appserver penwidth=2 shape=box3d style=filled zone=application]
	database [label="RDS Database" color="#7B2CBF" fillcolor="#240046" fontcolor="#E0AAFF" fontname=Helvetica fontsize=11 id=database penwidth=2 shape=box3d style=filled zone=data]
	secrets [label="Secrets Manager" color="#7B2CBF" fillcolor="#240046" fontcolor="#E0AAFF" fontname=Helvetica fontsize=11 id=secrets penwidth=2 shape=box3d style=filled zone=secure]
	vuln_waf_bypass [label="WAF Bypass\n(CVSS: 4.8 - Medium)*" color="#FF8500" fillcolor="#8c3e12" fontcolor="#ffffff" fontname=Helvetica fontsize=10 id=vuln_waf_bypass penwidth=2 shape=diamond style=filled]
	vuln_web_ssrf [label="SSRF Vulnerability\n(CVSS: 9.3 - Critical)*" color="#FF8500" fillcolor="#ff6d00" fontcolor="#1f2937" fontname=Helvetica fontsize=10 id=vuln_web_ssrf penwidth=2 peripheries=2 shape=diamond style=filled]
	vuln_app_rce [label="Remote Code Execution\n(CVSS: 8.8 - High)*" color="#FF8500" fillcolor="#c65609" fontcolor="#ffffff" fontname=Helvetica fontsize=10 id=vuln_app_rce penwidth=2 shape=diamond style=filled]
	vuln_db_sqli [label="SQL Injection\n(CVSS: 8.1 - High)*" color="#FF8500" fillcolor="#c65609" fontcolor="#ffffff" fontname=Helvetica fontsize=10 id=vuln_db_sqli penwidth=2 shape=diamond style=filled]
	vuln_secrets_iam [label="IAM Misconfiguration\n(CVSS: 7.7 - High)*" color="#FF8500" fillcolor="#c65609" fontcolor="#ffffff" fontname=Helvetica fontsize=10 id=vuln_secrets_iam penwidth=2 shape=diamond style=filled]
	priv_waf_access [label="WAF Bypass\n[bypass]" color="#C77DFF" description="Bypass WAF protection" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 id=priv_waf_access penwidth=2 shape=ellipse style=filled]
	priv_web_user [label="Web User Shell\n[user]" color="#C77DFF" description="User-level access on web server" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 id=priv_web_user penwidth=2 shape=ellipse style=filled]
	priv_app_exec [label="Lambda Execution\n[function]" color="#C77DFF" description="Code execution in Lambda" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 id=priv_app_exec penwidth=2 shape=ellipse style=filled]
	priv_db_read [label="Database Read\n[read]" color="#C77DFF" description="Read access to database" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 id=priv_db_read penwidth=2 shape=ellipse style=filled]
	priv_db_admin [label="Database Admin\n[admin]" color="#C77DFF" description="Admin access to database" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 id=priv_db_admin penwidth=2 shape=ellipse style=filled]
	priv_secrets_read [label="Secrets Access\n[read]" color="#C77DFF" description="Read secrets from manager" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 id=priv_secrets_read penwidth=2 shape=ellipse style=filled]
	svc_https [label="HTTPS\n:443" color="#7B2CBF" fillcolor="#5A189A" fontcolor=white fontname=Helvetica fontsize=10 id=svc_https penwidth=2 shape=component style=filled]
	svc_http [label="HTTP\n:80" color="#7B2CBF" fillcolor="#5A189A" fontcolor=white fontname=Helvetica fontsize=10 id=svc_http penwidth=2 shape=component style=filled]
	svc_api [label="REST API\n:443" color="#7B2CBF" fillcolor="#5A189A" fontcolor=white fontname=Helvetica fontsize=10 id=svc_api penwidth=2 shape=component style=filled]
	svc_postgres [label="PostgreSQL\n:5432" color="#7B2CBF" fillcolor="#5A189A" fontcolor=white fontname=Helvetica fontsize=10 id=svc_postgres penwidth=2 shape=component style=filled]
	attacker -> waf [label="Internet Access" color="#C77DFF" fontcolor="#C77DFF" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	waf -> loadbalancer [label="Filtered Traffic" color="#C77DFF" fontcolor="#C77DFF" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	loadbalancer -> webserver [label="Load Balanced" color="#C77DFF" fontcolor="#C77DFF" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	webserver -> appserver [label="API Calls" color="#C77DFF" fontcolor="#C77DFF" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	appserver -> database [label="DB Connection" color="#C77DFF" fontcolor="#C77DFF" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	appserver -> secrets [label="Secrets Access" color="#C77DFF" fontcolor="#C77DFF" fontname=Helvetica fontsize=9 penwidth=1.5 style=dashed]
	exploit_waf_bypass [label="WAF Encoding Bypass" color="#FF6D00" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 penwidth=2 shape=hexagon style=filled]
	attacker -> exploit_waf_bypass [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_waf_bypass -> priv_waf_access [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_ssrf [label="SSRF to Internal" color="#FF6D00" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_waf_access -> exploit_ssrf [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_ssrf -> priv_web_user [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_rce [label="Lambda RCE" color="#FF6D00" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_web_user -> exploit_rce [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_rce -> priv_app_exec [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_sqli [label="SQL Injection Attack" color="#FF6D00" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_app_exec -> exploit_sqli [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_sqli -> priv_db_read [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_secrets [label="IAM Role Abuse" color="#FF6D00" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_app_exec -> exploit_secrets [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_secrets -> priv_secrets_read [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_db_admin [label="Privilege Escalation" color="#FF6D00" fillcolor="#E0AAFF" fontcolor="#240046" fontname=Helvetica fontsize=10 penwidth=2 shape=hexagon style=filled]
	priv_db_read -> exploit_db_admin [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	exploit_db_admin -> priv_db_admin [color="#FF6D00" fontcolor="#FF6D00" fontname=Helvetica fontsize=9 penwidth=2.5 style=bold]
	waf -> vuln_waf_bypass [color="#95a5a6" style=dotted]
	webserver -> vuln_web_ssrf [color="#95a5a6" style=dotted]
	appserver -> vuln_app_rce [color="#95a5a6" style=dotted]
	database -> vuln_db_sqli [color="#95a5a6" style=dotted]
	secrets -> vuln_secrets_iam [color="#95a5a6" style=dotted]
	waf -> svc_https [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	appserver -> svc_api [color="#95a5a6" style=dotted]
	database -> svc_postgres [color="#95a5a6" style=dotted]
}
