digraph "Cloud Infrastructure Attack Graph" {
	bgcolor="#fafafa" fontname=Arial rankdir=LR splines=ortho
	label="Cloud Infrastructure Attack Graph" labelloc=t
	attacker [label=Attacker fillcolor="#1e3a5f" fontcolor=white fontname=Arial fontsize=11 id=attacker margin=0.15 shape=box style="filled,rounded" zone=external]
	waf [label="WAF/CDN" fillcolor="#1e3a5f" fontcolor=white fontname=Arial fontsize=11 id=waf margin=0.15 shape=box style="filled,rounded" zone="edge"]
	loadbalancer [label="Load Balancer" fillcolor="#1e3a5f" fontcolor=white fontname=Arial fontsize=11 id=loadbalancer margin=0.15 shape=box style="filled,rounded" zone=dmz]
	webserver [label="Web Server" fillcolor="#1e3a5f" fontcolor=white fontname=Arial fontsize=11 id=webserver margin=0.15 shape=box style="filled,rounded" zone=web]
	appserver [label="Application Server" fillcolor="#1e3a5f" fontcolor=white fontname=Arial fontsize=11 id=appserver margin=0.15 shape=box style="filled,rounded" zone=application]
	database [label="RDS Database" fillcolor="#1e3a5f" fontcolor=white fontname=Arial fontsize=11 id=database margin=0.15 shape=box style="filled,rounded" zone=data]
	secrets [label="Secrets Manager" fillcolor="#1e3a5f" fontcolor=white fontname=Arial fontsize=11 id=secrets margin=0.15 shape=box style="filled,rounded" zone=secure]
	vuln_waf_bypass [label="WAF Bypass\n(CVSS: 4.8 - Medium)*" fillcolor="#8b0000" fontcolor=white fontname=Arial fontsize=10 id=vuln_waf_bypass shape=diamond style=filled]
	vuln_web_ssrf [label="SSRF Vulnerability\n(CVSS: 9.3 - Critical)*" fillcolor="#8b0000" fontcolor=white fontname=Arial fontsize=10 id=vuln_web_ssrf shape=diamond style=filled]
	vuln_app_rce [label="Remote Code Execution\n(CVSS: 8.8 - High)*" fillcolor="#8b0000" fontcolor=white fontname=Arial fontsize=10 id=vuln_app_rce shape=diamond style=filled]
	vuln_db_sqli [label="SQL Injection\n(CVSS: 8.1 - High)*" fillcolor="#8b0000" fontcolor=white fontname=Arial fontsize=10 id=vuln_db_sqli shape=diamond style=filled]
	vuln_secrets_iam [label="IAM Misconfiguration\n(CVSS: 7.7 - High)*" fillcolor="#8b0000" fontcolor=white fontname=Arial fontsize=10 id=vuln_secrets_iam shape=diamond style=filled]
	priv_waf_access [label="WAF Bypass\n[bypass]" description="Bypass WAF protection" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_waf_access shape=ellipse style=filled]
	priv_web_user [label="Web User Shell\n[user]" description="User-level access on web server" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_web_user shape=ellipse style=filled]
	priv_app_exec [label="Lambda Execution\n[function]" description="Code execution in Lambda" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_app_exec shape=ellipse style=filled]
	priv_db_read [label="Database Read\n[read]" description="Read access to database" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_db_read shape=ellipse style=filled]
	priv_db_admin [label="Database Admin\n[admin]" description="Admin access to database" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_db_admin shape=ellipse style=filled]
	priv_secrets_read [label="Secrets Access\n[read]" description="Read secrets from manager" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 id=priv_secrets_read shape=ellipse style=filled]
	svc_https [label="HTTPS\n:443" fillcolor="#3d5a80" fontcolor=white fontname=Arial fontsize=10 id=svc_https shape=component style=filled]
	svc_http [label="HTTP\n:80" fillcolor="#3d5a80" fontcolor=white fontname=Arial fontsize=10 id=svc_http shape=component style=filled]
	svc_api [label="REST API\n:443" fillcolor="#3d5a80" fontcolor=white fontname=Arial fontsize=10 id=svc_api shape=component style=filled]
	svc_postgres [label="PostgreSQL\n:5432" fillcolor="#3d5a80" fontcolor=white fontname=Arial fontsize=10 id=svc_postgres shape=component style=filled]
	attacker -> waf [label="Internet Access" color="#4682b4" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	waf -> loadbalancer [label="Filtered Traffic" color="#4682b4" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	loadbalancer -> webserver [label="Load Balanced" color="#4682b4" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	webserver -> appserver [label="API Calls" color="#4682b4" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	appserver -> database [label="DB Connection" color="#4682b4" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	appserver -> secrets [label="Secrets Access" color="#4682b4" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	exploit_waf_bypass [label="WAF Encoding Bypass" color="#8b0000" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 shape=hexagon style=filled]
	attacker -> exploit_waf_bypass [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_waf_bypass -> priv_waf_access [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_ssrf [label="SSRF to Internal" color="#8b0000" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 shape=hexagon style=filled]
	priv_waf_access -> exploit_ssrf [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_ssrf -> priv_web_user [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_rce [label="Lambda RCE" color="#8b0000" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 shape=hexagon style=filled]
	priv_web_user -> exploit_rce [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_rce -> priv_app_exec [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_sqli [label="SQL Injection Attack" color="#8b0000" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 shape=hexagon style=filled]
	priv_app_exec -> exploit_sqli [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_sqli -> priv_db_read [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_secrets [label="IAM Role Abuse" color="#8b0000" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 shape=hexagon style=filled]
	priv_app_exec -> exploit_secrets [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_secrets -> priv_secrets_read [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_db_admin [label="Privilege Escalation" color="#8b0000" fillcolor="#b8860b" fontcolor="#1f2937" fontname=Arial fontsize=10 shape=hexagon style=filled]
	priv_db_read -> exploit_db_admin [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	exploit_db_admin -> priv_db_admin [color="#8b0000" fontname=Arial fontsize=9 penwidth=2 style=bold]
	waf -> vuln_waf_bypass [color="#95a5a6" style=dotted]
	webserver -> vuln_web_ssrf [color="#95a5a6" style=dotted]
	appserver -> vuln_app_rce [color="#95a5a6" style=dotted]
	database -> vuln_db_sqli [color="#95a5a6" style=dotted]
	secrets -> vuln_secrets_iam [color="#95a5a6" style=dotted]
	waf -> svc_https [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	appserver -> svc_api [color="#95a5a6" style=dotted]
	database -> svc_postgres [color="#95a5a6" style=dotted]
}
