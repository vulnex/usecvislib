digraph "Cloud Infrastructure Attack Graph" {
	bgcolor="#fafafa" fontname=Arial rankdir=TB splines=ortho
	label="Cloud Infrastructure Attack Graph" labelloc=t
	attacker [label=Attacker fillcolor="#2c3e50" fontcolor=white fontname="Arial Bold" fontsize=11 id=attacker shape=box3d style=filled zone=external]
	waf [label="WAF/CDN" fillcolor="#2c3e50" fontcolor=white fontname="Arial Bold" fontsize=11 id=waf shape=box3d style=filled zone="edge"]
	loadbalancer [label="Load Balancer" fillcolor="#2c3e50" fontcolor=white fontname="Arial Bold" fontsize=11 id=loadbalancer shape=box3d style=filled zone=dmz]
	webserver [label="Web Server" fillcolor="#2c3e50" fontcolor=white fontname="Arial Bold" fontsize=11 id=webserver shape=box3d style=filled zone=web]
	appserver [label="Application Server" fillcolor="#2c3e50" fontcolor=white fontname="Arial Bold" fontsize=11 id=appserver shape=box3d style=filled zone=application]
	database [label="RDS Database" fillcolor="#2c3e50" fontcolor=white fontname="Arial Bold" fontsize=11 id=database shape=box3d style=filled zone=data]
	secrets [label="Secrets Manager" fillcolor="#2c3e50" fontcolor=white fontname="Arial Bold" fontsize=11 id=secrets shape=box3d style=filled zone=secure]
	vuln_waf_bypass [label="WAF Bypass\n(CVSS: 4.8 - Medium)*" fillcolor="#dd9a92" fontcolor="#1f2937" fontname="Arial Bold" fontsize=11 id=vuln_waf_bypass penwidth=2 shape=diamond style="filled,bold"]
	vuln_web_ssrf [label="SSRF Vulnerability\n(CVSS: 9.3 - Critical)*" fillcolor="#c0392b" fontcolor="#ffffff" fontname="Arial Bold" fontsize=11 id=vuln_web_ssrf penwidth=2 peripheries=2 shape=diamond style="filled,bold"]
	vuln_app_rce [label="Remote Code Execution\n(CVSS: 8.8 - High)*" fillcolor="#ce695f" fontcolor="#1f2937" fontname="Arial Bold" fontsize=11 id=vuln_app_rce penwidth=2 shape=diamond style="filled,bold"]
	vuln_db_sqli [label="SQL Injection\n(CVSS: 8.1 - High)*" fillcolor="#ce695f" fontcolor="#1f2937" fontname="Arial Bold" fontsize=11 id=vuln_db_sqli penwidth=2 shape=diamond style="filled,bold"]
	vuln_secrets_iam [label="IAM Misconfiguration\n(CVSS: 7.7 - High)*" fillcolor="#ce695f" fontcolor="#1f2937" fontname="Arial Bold" fontsize=11 id=vuln_secrets_iam penwidth=2 shape=diamond style="filled,bold"]
	priv_waf_access [label="WAF Bypass\n[bypass]" description="Bypass WAF protection" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 id=priv_waf_access penwidth=2 shape=ellipse style="filled,bold"]
	priv_web_user [label="Web User Shell\n[user]" description="User-level access on web server" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 id=priv_web_user penwidth=2 shape=ellipse style="filled,bold"]
	priv_app_exec [label="Lambda Execution\n[function]" description="Code execution in Lambda" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 id=priv_app_exec penwidth=2 shape=ellipse style="filled,bold"]
	priv_db_read [label="Database Read\n[read]" description="Read access to database" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 id=priv_db_read penwidth=2 shape=ellipse style="filled,bold"]
	priv_db_admin [label="Database Admin\n[admin]" description="Admin access to database" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 id=priv_db_admin penwidth=2 shape=ellipse style="filled,bold"]
	priv_secrets_read [label="Secrets Access\n[read]" description="Read secrets from manager" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 id=priv_secrets_read penwidth=2 shape=ellipse style="filled,bold"]
	svc_https [label="HTTPS\n:443" fillcolor="#7f8c8d" fontcolor=white fontname=Arial fontsize=10 id=svc_https shape=component style=filled]
	svc_http [label="HTTP\n:80" fillcolor="#7f8c8d" fontcolor=white fontname=Arial fontsize=10 id=svc_http shape=component style=filled]
	svc_api [label="REST API\n:443" fillcolor="#7f8c8d" fontcolor=white fontname=Arial fontsize=10 id=svc_api shape=component style=filled]
	svc_postgres [label="PostgreSQL\n:5432" fillcolor="#7f8c8d" fontcolor=white fontname=Arial fontsize=10 id=svc_postgres shape=component style=filled]
	attacker -> waf [label="Internet Access" color="#95a5a6" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	waf -> loadbalancer [label="Filtered Traffic" color="#95a5a6" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	loadbalancer -> webserver [label="Load Balanced" color="#95a5a6" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	webserver -> appserver [label="API Calls" color="#95a5a6" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	appserver -> database [label="DB Connection" color="#95a5a6" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	appserver -> secrets [label="Secrets Access" color="#95a5a6" fontname=Arial fontsize=9 penwidth=1.5 style=dashed]
	exploit_waf_bypass [label="WAF Encoding Bypass" color="#c0392b" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 penwidth=2 shape=hexagon style="filled,bold"]
	attacker -> exploit_waf_bypass [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_waf_bypass -> priv_waf_access [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_ssrf [label="SSRF to Internal" color="#c0392b" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 penwidth=2 shape=hexagon style="filled,bold"]
	priv_waf_access -> exploit_ssrf [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_ssrf -> priv_web_user [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_rce [label="Lambda RCE" color="#c0392b" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 penwidth=2 shape=hexagon style="filled,bold"]
	priv_web_user -> exploit_rce [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_rce -> priv_app_exec [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_sqli [label="SQL Injection Attack" color="#c0392b" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 penwidth=2 shape=hexagon style="filled,bold"]
	priv_app_exec -> exploit_sqli [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_sqli -> priv_db_read [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_secrets [label="IAM Role Abuse" color="#c0392b" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 penwidth=2 shape=hexagon style="filled,bold"]
	priv_app_exec -> exploit_secrets [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_secrets -> priv_secrets_read [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_db_admin [label="Privilege Escalation" color="#c0392b" fillcolor="#d35400" fontcolor=white fontname="Arial Bold" fontsize=11 penwidth=2 shape=hexagon style="filled,bold"]
	priv_db_read -> exploit_db_admin [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	exploit_db_admin -> priv_db_admin [arrowsize=1.2 color="#c0392b" fontname="Arial Bold" fontsize=10 penwidth=3 style=bold]
	waf -> vuln_waf_bypass [color="#95a5a6" style=dotted]
	webserver -> vuln_web_ssrf [color="#95a5a6" style=dotted]
	appserver -> vuln_app_rce [color="#95a5a6" style=dotted]
	database -> vuln_db_sqli [color="#95a5a6" style=dotted]
	secrets -> vuln_secrets_iam [color="#95a5a6" style=dotted]
	waf -> svc_https [color="#95a5a6" style=dotted]
	webserver -> svc_http [color="#95a5a6" style=dotted]
	appserver -> svc_api [color="#95a5a6" style=dotted]
	database -> svc_postgres [color="#95a5a6" style=dotted]
}
