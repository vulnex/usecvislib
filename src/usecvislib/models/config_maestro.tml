color = "#334466"
fontname = "Arial Bold"
fontsize = "14"
fontcolor = "#b0b0cc"
penwidth = "1"

[ma_dark.agent]
shape = "box"
style = "filled,rounded"
fontname = "Arial"
fontsize = "11"
fontcolor = "white"
fillcolor = "#0f3460"
color = "#2060a0"
penwidth = "1.5"
margin = "0.2,0.1"

[ma_dark.asset]
shape = "cylinder"
style = "filled"
fontname = "Arial"
fontsize = "10"
fontcolor = "white"
fillcolor = "#4a148c"
color = "#7b1fa2"
penwidth = "1.2"

[ma_dark.security_gutter]
style = "filled,rounded"
fillcolor = "#3d2817"
color = "#fb8c00"
fontname = "Arial Bold"
fontsize = "13"
fontcolor = "#ffb74d"
penwidth = "1.5"

[ma_dark.cross_layer_edge]
style = "dashed"
color = "#ff6b6b"
fontname = "Arial"
fontsize = "9"
fontcolor = "#ff8a80"
penwidth = "1.5"
