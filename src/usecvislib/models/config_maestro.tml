# =============================================================================
# Severity - Heatmap-tuned palette emphasizing risk
# =============================================================================
[ma_severity]
[ma_severity.graph]
rankdir = "TB"
bgcolor = "white"
fontname = "Arial"
splines = "ortho"
nodesep = "0.5"
ranksep = "0.7"
pad = "0.5"
compound = "true"

[ma_severity.layer]
style = "filled,rounded"
fillcolor = "#fafafa"
color = "#bdbdbd"
fontname = "Arial Bold"
fontsize = "14"
fontcolor = "#212121"
penwidth = "1"

[ma_severity.agent]
shape = "box"
style = "filled,rounded"
fontname = "Arial"
fontsize = "11"
fontcolor = "#212121"
fillcolor = "#ffe0b2"
color = "#e65100"
penwidth = "1.5"
margin = "0.2,0.1"

[ma_severity.asset]
shape = "cylinder"
style = "filled"
fontname = "Arial"
fontsize = "10"
fontcolor = "#b71c1c"
fillcolor = "#ffcdd2"
color = "#c62828"
penwidth = "1.2"

[ma_severity.security_gutter]
style = "filled,rounded"
fillcolor = "#fff3e0"
color = "#e53935"
fontname = "Arial Bold"
fontsize = "13"
fontcolor = "#b71c1c"
penwidth = "1.5"

[ma_severity.cross_layer_edge]
style = "bold"
color = "#b71c1c"
fontname = "Arial Bold"
fontsize = "10"
fontcolor = "#b71c1c"
penwidth = "2"
arrowhead = "normal"

# =============================================================================
# Compact - Minimal spacing for dense models
# =============================================================================
[ma_compact]
[ma_compact.graph]
rankdir = "TB"
bgcolor = "white"
fontname = "Helvetica"
splines = "ortho"
nodesep = "0.3"
ranksep = "0.4"
pad = "0.25"
compound = "true"

[ma_compact.layer]
style = "rounded"
fillcolor = "white"
color = "#e0e0e0"
fontname = "Helvetica"
fontsize = "11"
fontcolor = "#555555"
penwidth = "1"

[ma_compact.agent]
shape = "box"
style = "filled,rounded"
fontname = "Helvetica"
fontsize = "9"
fontcolor = "#333333"
fillcolor = "white"
color = "#999999"
penwidth = "1"
margin = "0.1,0.05"

[ma_compact.asset]
shape = "cylinder"
style = "filled"
fontname = "Helvetica"
fontsize = "8"
fontcolor = "#333333"
fillcolor = "white"
color = "#999999"
penwidth = "1"

[ma_compact.security_gutter]
style = "rounded"
fillcolor = "white"
color = "#bbbbbb"
fontname = "Helvetica"
fontsize = "10"
fontcolor = "#555555"
penwidth = "1"

[ma_compact.cross_layer_edge]
style = "dashed"
color = "#bbbbbb"
fontname = "Helvetica"
fontsize = "8"
fontcolor = "#999999"
penwidth = "1"
arrowhead = "open"
