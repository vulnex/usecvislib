# =============================================================================
# Compact - Minimal spacing for dense models
# =============================================================================
[ma_compact]
[ma_compact.graph]
rankdir = "TB"
bgcolor = "white"
fontname = "Helvetica"
splines = "polyline"
nodesep = "0.3"
ranksep = "0.4"
pad = "0.25"
compound = "true"

[ma_compact.layer]
style = "rounded"
fillcolor = "white"
color = "#e0e0e0"
fontname = "Helvetica"
fontsize = "11"
fontcolor = "#555555"
penwidth = "1"

[ma_compact.agent]
shape = "box"
style = "filled,rounded"
fontname = "Helvetica"
fontsize = "9"
fontcolor = "#333333"
fillcolor = "white"
color = "#999999"
penwidth = "1"
margin = "0.1,0.05"

[ma_compact.asset]
shape = "cylinder"
style = "filled"
fontname = "Helvetica"
fontsize = "8"
fontcolor = "#333333"
fillcolor = "white"
color = "#999999"
penwidth = "1"

[ma_compact.security_gutter]
style = "rounded"
