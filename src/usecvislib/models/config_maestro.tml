color = "#bbbbbb"
fontname = "Helvetica"
fontsize = "8"
fontcolor = "#999999"
penwidth = "1"
arrowhead = "open"

# =============================================================================
# SVG engine presets (render_engine="svg"). Marked with meta.engine = "svg".
# Only the agent-centric `graph` view is SVG-native. The 7-layer color palette
# is inherited from the engine defaults; presets tune borders/text/spacing.
# =============================================================================

# SVG Default - pastel MAESTRO layers, slate chains
[sv_default]
meta = {engine = "svg"}
title = {show = true, size = 15}
page = {background = "#f8fafc", padding = 44, text = "#111827"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 10, padding_x = 16, padding_y = 11, border_width = 1.0, min_width = 120, max_label_width = 220}
node = {fill = "#90caf9", border = "#616161", text = "#1f2937"}
edge = {color = "#94a3b8", width = 1.6, routing = "spline", label_size = 10, label_color = "#64748b"}
effects = {shadow = true, shadow_blur = 2.2, hover_glow = true}
cluster = {fill = "#eef2f7", border = "#bdbdbd", text = "#374151", label_size = 12, radius = 10}
maestro = {agent_border = "#616161", critical_border = "#e53935", layer_border = "#bdbdbd", layer_text = "#374151", chain_fallback = "#94a3b8", text = "#1f2937", rankdir = "LR", nodesep = 0.5, ranksep = 0.9}

# SVG Dark - night-ops board
[sv_dark]
meta = {engine = "svg"}
title = {show = true, size = 15}
page = {background = "#0f172a", padding = 44, text = "#e2e8f0"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 10, padding_x = 16, padding_y = 11, border_width = 1.0, min_width = 120, max_label_width = 220}
node = {fill = "#90caf9", border = "#94a3b8", text = "#1f2937"}
edge = {color = "#64748b", width = 1.6, routing = "spline", label_size = 10, label_color = "#94a3b8"}
effects = {shadow = true, shadow_blur = 2.6, hover_glow = true}
cluster = {fill = "#1e293b", border = "#475569", text = "#cbd5e1", label_size = 12, radius = 10}
[sv_dark.maestro]
agent_border = "#94a3b8"
critical_border = "#ff6b6b"
layer_border = "#475569"
layer_text = "#cbd5e1"
chain_fallback = "#64748b"
text = "#1f2937"
rankdir = "LR"
nodesep = 0.5
ranksep = 0.9

# Dark-tinted layer clusters: the default pastels left the light layer titles unreadable
[sv_dark.maestro.layers.agent-ecosystem]
cluster = "#1e3a5f"
[sv_dark.maestro.layers.agent-frameworks]
cluster = "#3b2450"
[sv_dark.maestro.layers.foundation-models]
cluster = "#1f3d2b"
[sv_dark.maestro.layers.data-operations]
cluster = "#4a3418"
[sv_dark.maestro.layers.infrastructure]
cluster = "#4a1f33"
[sv_dark.maestro.layers.observability]
cluster = "#163f45"
[sv_dark.maestro.layers.security]
cluster = "#4a3f12"

# SVG Security - high-contrast
[sv_security]
meta = {engine = "svg"}
title = {show = true, size = 16}
page = {background = "#f5f7fa", padding = 46, text = "#0f172a"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 8, padding_x = 16, padding_y = 11, border_width = 1.4, min_width = 124, max_label_width = 230}
node = {fill = "#90caf9", border = "#0f172a", text = "#1f2937"}
edge = {color = "#475569", width = 1.9, routing = "spline", label_size = 10, label_color = "#475569"}
effects = {shadow = true, shadow_blur = 2.4, hover_glow = true}
cluster = {fill = "#e5e9ef", border = "#94a3b8", text = "#0f172a", label_size = 12, radius = 8}
maestro = {agent_border = "#334155", critical_border = "#c0392b", layer_border = "#94a3b8", layer_text = "#0f172a", chain_fallback = "#64748b", text = "#0f172a", rankdir = "LR", nodesep = 0.55, ranksep = 0.95}

# SVG Corporate - professional for reports
[sv_corporate]
meta = {engine = "svg"}
title = {show = true, size = 15}
page = {background = "#ffffff", padding = 48, text = "#16324f"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 6, padding_x = 15, padding_y = 10, border_width = 1.0, min_width = 120, max_label_width = 225}
node = {fill = "#90caf9", border = "#16324f", text = "#16324f"}
edge = {color = "#6b7b8c", width = 1.5, routing = "spline", label_size = 10, label_color = "#4a5b6b"}
effects = {shadow = true, shadow_blur = 1.8, hover_glow = false}
cluster = {fill = "#f1f4f7", border = "#c3ced9", text = "#16324f", label_size = 12, radius = 6}
maestro = {agent_border = "#4a5b6b", critical_border = "#b83227", layer_border = "#c3ced9", layer_text = "#16324f", chain_fallback = "#6b7b8c", text = "#16324f", rankdir = "LR", nodesep = 0.5, ranksep = 0.9}

# SVG Minimal - flat outline
[sv_minimal]
meta = {engine = "svg"}
title = {show = false, size = 14}
page = {background = "#ffffff", padding = 40, text = "#475569"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 15}
card = {radius = 4, padding_x = 14, padding_y = 9, border_width = 1.0, min_width = 112, max_label_width = 210}
node = {fill = "#90caf9", border = "#cbd5e1", text = "#1f2937"}
edge = {color = "#cbd5e1", width = 1.3, routing = "spline", label_size = 10, label_color = "#94a3b8"}
effects = {shadow = false, shadow_blur = 0, hover_glow = true}
cluster = {fill = "#f4f6f8", border = "#e2e8f0", text = "#64748b", label_size = 12, radius = 4}
maestro = {agent_border = "#94a3b8", critical_border = "#d9534f", layer_border = "#e2e8f0", layer_text = "#64748b", chain_fallback = "#cbd5e1", text = "#1f2937", rankdir = "LR", nodesep = 0.45, ranksep = 0.8}
