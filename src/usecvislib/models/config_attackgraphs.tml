privilege = {shape = "ellipse", style = "filled", fillcolor = "#E0AAFF", fontcolor = "#240046", fontname = "Helvetica", fontsize = "10", penwidth = "2", color = "#C77DFF"}
service = {shape = "component", style = "filled", fillcolor = "#5A189A", fontcolor = "white", fontname = "Helvetica", fontsize = "10", penwidth = "2", color = "#7B2CBF"}
