vulnerability = {shape = "diamond", style = "filled", fillcolor = "#1a1a2e", fontcolor = "#ff0080", fontname = "Consolas", fontsize = "10", penwidth = "2", color = "#ff0080"}
privilege = {shape = "ellipse", style = "filled", fillcolor = "#1a1a2e", fontcolor = "#ffff00", fontname = "Consolas", fontsize = "10", penwidth = "2", color = "#ffff00"}
service = {shape = "component", style = "filled", fillcolor = "#1a1a2e", fontcolor = "#00d4ff", fontname = "Consolas", fontsize = "10", penwidth = "2", color = "#00d4ff"}
edge = {color = "#444444", fontname = "Consolas", fontsize = "9", fontcolor = "#888888"}
network_edge = {color = "#00d4ff", style = "dashed", fontname = "Consolas", fontsize = "9", penwidth = "2", fontcolor = "#00d4ff"}
exploit_edge = {color = "#ff0080", style = "bold", fontname = "Consolas", fontsize = "9", penwidth = "3", fontcolor = "#ff0080"}

# =============================================================================
# Corporate - Professional enterprise style
# =============================================================================
[ag_corporate]
graph = {rankdir = "LR", bgcolor = "#fafafa", fontname = "Arial", splines = "ortho"}
host = {shape = "box", style = "filled,rounded", fillcolor = "#1e3a5f", fontcolor = "white", fontname = "Arial", fontsize = "11", margin = "0.15"}
vulnerability = {shape = "diamond", style = "filled", fillcolor = "#8b0000", fontcolor = "white", fontname = "Arial", fontsize = "10"}
privilege = {shape = "ellipse", style = "filled", fillcolor = "#b8860b", fontcolor = "white", fontname = "Arial", fontsize = "10"}
service = {shape = "component", style = "filled", fillcolor = "#3d5a80", fontcolor = "white", fontname = "Arial", fontsize = "10"}
edge = {color = "#6b7b8c", fontname = "Arial", fontsize = "9", penwidth = "1.5"}
