# =============================================================================
# SVG-engine presets (render_engine="svg"). These paint modern cards over a
# Graphviz-computed layout (GraphvizJsonLayout oracle) — they do NOT use the
# Graphviz `graph/host/...` keys above. Node fill is per-kind; vulnerabilities
# recolor by CVSS when severity.use_cvss_colors is true.
# =============================================================================

# SVG Default - clean cards on a soft slate page
[sv_default]
meta = {engine = "svg"}
title = {show = true, size = 15}
page = {background = "#f8fafc", padding = 44, text = "#111827"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 10, padding_x = 16, padding_y = 11, border_width = 1.0, min_width = 116, max_label_width = 220}
node = {fill = "#3d5a80", border = "#1e293b", text = "#ffffff"}
edge = {color = "#94a3b8", width = 1.6, routing = "spline", label_size = 10, label_color = "#64748b"}
effects = {shadow = true, shadow_blur = 2.2, hover_glow = true}
severity = {use_cvss_colors = true}
badges = {cvss = true, fill = "#0f172a", text = "#ffffff"}
attackgraph = {host = "#3d5a80", vulnerability = "#e74c3c", privilege = "#e08e0b", service = "#2f8f4e", exploit = "#8e44ad", border = "#1e293b", network_edge = "#3b82c4", exploit_edge = "#c0392b", structural_edge = "#94a3b8", exploit_edge_width = 2.4, rankdir = "LR", nodesep = 0.4, ranksep = 0.7}

# SVG Dark - slate night-ops board
[sv_dark]
meta = {engine = "svg"}
title = {show = true, size = 15}
page = {background = "#0f172a", padding = 44, text = "#e2e8f0"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 10, padding_x = 16, padding_y = 11, border_width = 1.0, min_width = 116, max_label_width = 220}
node = {fill = "#33507a", border = "#475569", text = "#ffffff"}
edge = {color = "#64748b", width = 1.6, routing = "spline", label_size = 10, label_color = "#94a3b8"}
effects = {shadow = true, shadow_blur = 2.6, hover_glow = true}
severity = {use_cvss_colors = true}
badges = {cvss = true, fill = "#e2e8f0", text = "#0f172a"}
attackgraph = {host = "#33507a", vulnerability = "#e74c3c", privilege = "#e08e0b", service = "#2f8f4e", exploit = "#a05fc0", border = "#475569", network_edge = "#4a90d9", exploit_edge = "#ff6b6b", structural_edge = "#64748b", exploit_edge_width = 2.6, rankdir = "LR", nodesep = 0.4, ranksep = 0.7}

# SVG Security - high-contrast severity heat
[sv_security]
meta = {engine = "svg"}
title = {show = true, size = 16}
page = {background = "#f5f7fa", padding = 46, text = "#0f172a"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 8, padding_x = 16, padding_y = 11, border_width = 1.4, min_width = 124, max_label_width = 230}
node = {fill = "#2c3e50", border = "#0f172a", text = "#ffffff"}
edge = {color = "#64748b", width = 1.9, routing = "spline", label_size = 10, label_color = "#475569"}
effects = {shadow = true, shadow_blur = 2.4, hover_glow = true}
severity = {use_cvss_colors = true}
badges = {cvss = true, fill = "#000000", text = "#ffffff"}
attackgraph = {host = "#2c3e50", vulnerability = "#c0392b", privilege = "#d35400", service = "#5c7784", exploit = "#7d3c98", border = "#0f172a", network_edge = "#5b7c99", exploit_edge = "#c0392b", structural_edge = "#94a3b8", exploit_edge_width = 3.0, rankdir = "TB", nodesep = 0.45, ranksep = 0.8}

# SVG Corporate - professional blue-on-white for reports
[sv_corporate]
meta = {engine = "svg"}
title = {show = true, size = 15}
page = {background = "#ffffff", padding = 48, text = "#16324f"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 6, padding_x = 15, padding_y = 10, border_width = 1.0, min_width = 120, max_label_width = 225}
node = {fill = "#2f5f8a", border = "#16324f", text = "#ffffff"}
edge = {color = "#6b7b8c", width = 1.5, routing = "spline", label_size = 10, label_color = "#4a5b6b"}
effects = {shadow = true, shadow_blur = 1.8, hover_glow = false}
severity = {use_cvss_colors = true}
badges = {cvss = true, fill = "#16324f", text = "#ffffff"}
attackgraph = {host = "#2f5f8a", vulnerability = "#c0392b", privilege = "#c47f16", service = "#2f7f57", exploit = "#7d4fa0", border = "#16324f", network_edge = "#3f6f9c", exploit_edge = "#b83227", structural_edge = "#9aa8b5", exploit_edge_width = 2.4, rankdir = "LR", nodesep = 0.42, ranksep = 0.75}

# SVG Minimal - flat outline, no depth
[sv_minimal]
meta = {engine = "svg"}
title = {show = false, size = 14}
page = {background = "#ffffff", padding = 40, text = "#475569"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 15}
card = {radius = 4, padding_x = 14, padding_y = 9, border_width = 1.0, min_width = 112, max_label_width = 210}
node = {fill = "#5b7896", border = "#cbd5e1", text = "#ffffff"}
edge = {color = "#cbd5e1", width = 1.3, routing = "spline", label_size = 10, label_color = "#94a3b8"}
effects = {shadow = false, shadow_blur = 0, hover_glow = true}
severity = {use_cvss_colors = true}
badges = {cvss = true, fill = "#334155", text = "#ffffff"}
attackgraph = {host = "#5b7896", vulnerability = "#e06b5e", privilege = "#e0a24b", service = "#5aa579", exploit = "#a172bf", border = "#cbd5e1", network_edge = "#7fa8cc", exploit_edge = "#d9534f", structural_edge = "#cbd5e1", exploit_edge_width = 2.0, rankdir = "LR", nodesep = 0.38, ranksep = 0.68}
