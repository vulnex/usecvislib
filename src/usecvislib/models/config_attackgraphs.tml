host = {shape = "box3d", style = "filled", fillcolor = "#5b8db8", fontcolor = "white", fontname = "Arial", fontsize = "11", margin = "0.15"}
vulnerability = {shape = "diamond", style = "filled", fillcolor = "#90a4ae", fontcolor = "white", fontname = "Arial", fontsize = "10", margin = "0.1"}
