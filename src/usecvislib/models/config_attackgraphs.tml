service = {shape = "component", style = "filled", fillcolor = "#8D99AE", fontcolor = "white", fontname = "Helvetica", fontsize = "10", margin = "0.1"}
edge = {color = "#6C757D", fontname = "Helvetica", fontsize = "9"}
