#
# Config Component Diagram Styles
#

# =============================================================================
# Default - Light gray layers, blue components, gray connections
# =============================================================================
[cd_default]
[cd_default.graph]
rankdir = "TB"
bgcolor = "white"
fontname = "Arial"
splines = "ortho"
nodesep = "0.8"
ranksep = "1.0"
pad = "0.5"

[cd_default.layer]
style = "filled,rounded"
fillcolor = "#f5f5f5"
color = "#cccccc"
fontname = "Arial Bold"
fontsize = "14"
fontcolor = "#333333"
penwidth = "1"

[cd_default.component]
fontname = "Arial"
fontsize = "11"
fontcolor = "white"
fillcolor = "#4a90d9"
color = "#357abd"
penwidth = "1.5"
margin = "0.2,0.1"

[cd_default.connection]
color = "#666666"
fontname = "Arial"
fontsize = "9"
fontcolor = "#666666"
penwidth = "1.2"

# =============================================================================
# Blueprint - Dark blue background, white components
# =============================================================================
[cd_blueprint]
[cd_blueprint.graph]
rankdir = "TB"
bgcolor = "#1a2744"
fontname = "Courier New"
splines = "ortho"
nodesep = "0.8"
ranksep = "1.0"
pad = "0.5"
fontcolor = "#c0d0e0"

[cd_blueprint.layer]
style = "filled,rounded"
fillcolor = "#243656"
color = "#4a6a8a"
fontname = "Courier New"
fontsize = "14"
fontcolor = "#a0c0e0"
penwidth = "1"

[cd_blueprint.component]
fontname = "Courier New"
fontsize = "11"
fontcolor = "#1a2744"
fillcolor = "#c0d8f0"
color = "#8ab0d8"
penwidth = "1.5"
margin = "0.2,0.1"

[cd_blueprint.connection]
color = "#6090c0"
fontname = "Courier New"
fontsize = "9"
fontcolor = "#80b0d0"
penwidth = "1.2"

# =============================================================================
# Minimal - White background, thin borders, maximum readability
# =============================================================================
[cd_minimal]
[cd_minimal.graph]
rankdir = "TB"
bgcolor = "white"
fontname = "Helvetica"
splines = "ortho"
nodesep = "0.8"
ranksep = "1.0"
pad = "0.5"

[cd_minimal.layer]
style = "rounded"
fillcolor = "white"
color = "#e0e0e0"
fontname = "Helvetica"
fontsize = "13"
fontcolor = "#555555"
penwidth = "1"

[cd_minimal.component]
fontname = "Helvetica"
fontsize = "11"
fontcolor = "#333333"
fillcolor = "white"
color = "#999999"
penwidth = "1"
margin = "0.2,0.1"

[cd_minimal.connection]
color = "#bbbbbb"
fontname = "Helvetica"
fontsize = "9"
fontcolor = "#999999"
penwidth = "1"

# =============================================================================
# Dark - Dark background, high-contrast components
# =============================================================================
[cd_dark]
[cd_dark.graph]
rankdir = "TB"
bgcolor = "#1a1a2e"
fontname = "Arial"
splines = "ortho"
nodesep = "0.8"
ranksep = "1.0"
pad = "0.5"
fontcolor = "#e0e0e0"

[cd_dark.layer]
style = "filled,rounded"
fillcolor = "#16213e"
color = "#334466"
fontname = "Arial Bold"
fontsize = "14"
fontcolor = "#b0b0cc"
penwidth = "1"

[cd_dark.component]
fontname = "Arial"
fontsize = "11"
fontcolor = "white"
fillcolor = "#0f3460"
color = "#2060a0"
penwidth = "1.5"
margin = "0.2,0.1"

[cd_dark.connection]
color = "#506080"
fontname = "Arial"
fontsize = "9"
fontcolor = "#8090a0"
penwidth = "1.2"

# =============================================================================
# SVG engine presets (render_engine="svg"). Marked with meta.engine = "svg".
# The layer-color palette is inherited from the engine defaults; presets tune
# the component/connection/layer-border colors and oracle spacing.
# =============================================================================

# SVG Default - slate cards, pastel layers
[sv_default]
meta = {engine = "svg"}
title = {show = true, size = 15}
page = {background = "#f8fafc", padding = 44, text = "#111827"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 10, padding_x = 16, padding_y = 11, border_width = 1.0, min_width = 116, max_label_width = 220}
node = {fill = "#4a90d9", border = "#1e293b", text = "#ffffff"}
edge = {color = "#64748b", width = 1.6, routing = "spline", label_size = 10, label_color = "#64748b"}
effects = {shadow = true, shadow_blur = 2.2, hover_glow = true}
cluster = {fill = "#eef2f7", border = "#cbd5e1", text = "#334155", label_size = 12, radius = 10}
componentdiagram = {component = "#4a90d9", component_border = "#1e293b", text = "#ffffff", connection = "#64748b", layer_border = "#cbd5e1", layer_text = "#334155", rankdir = "TB", nodesep = 0.5, ranksep = 0.7}

# SVG Dark - slate night-ops board
[sv_dark]
meta = {engine = "svg"}
title = {show = true, size = 15}
page = {background = "#0f172a", padding = 44, text = "#e2e8f0"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 10, padding_x = 16, padding_y = 11, border_width = 1.0, min_width = 116, max_label_width = 220}
node = {fill = "#33507a", border = "#475569", text = "#ffffff"}
edge = {color = "#64748b", width = 1.6, routing = "spline", label_size = 10, label_color = "#94a3b8"}
effects = {shadow = true, shadow_blur = 2.6, hover_glow = true}
cluster = {fill = "#1e293b", border = "#334155", text = "#cbd5e1", label_size = 12, radius = 10}
componentdiagram = {component = "#33507a", component_border = "#475569", text = "#ffffff", connection = "#64748b", layer_palette = ["#182338", "#231a30", "#16281c", "#2c2410", "#2a1620", "#12262a", "#1f2716", "#221a30"], layer_border = "#334155", layer_text = "#cbd5e1", rankdir = "TB", nodesep = 0.5, ranksep = 0.7}

# SVG Security - high-contrast
[sv_security]
meta = {engine = "svg"}
title = {show = true, size = 16}
page = {background = "#f5f7fa", padding = 46, text = "#0f172a"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 8, padding_x = 16, padding_y = 11, border_width = 1.4, min_width = 124, max_label_width = 230}
node = {fill = "#2c3e50", border = "#0f172a", text = "#ffffff"}
edge = {color = "#475569", width = 1.9, routing = "spline", label_size = 10, label_color = "#475569"}
effects = {shadow = true, shadow_blur = 2.4, hover_glow = true}
cluster = {fill = "#e5e9ef", border = "#94a3b8", text = "#0f172a", label_size = 12, radius = 8}
componentdiagram = {component = "#2c3e50", component_border = "#0f172a", text = "#ffffff", connection = "#475569", layer_border = "#94a3b8", layer_text = "#0f172a", rankdir = "TB", nodesep = 0.55, ranksep = 0.8}

# SVG Corporate - professional blue-on-white for reports
[sv_corporate]
meta = {engine = "svg"}
title = {show = true, size = 15}
page = {background = "#ffffff", padding = 48, text = "#16324f"}
font = {family = "Calibri, Carlito, Segoe UI, Arial, sans-serif", size = 13, root_size = 16}
card = {radius = 3, padding_x = 15, padding_y = 10, border_width = 1.3, min_width = 120, max_label_width = 225}
node = {fill = "#2f5f8a", border = "#16324f", text = "#ffffff"}
edge = {color = "#6b7b8c", width = 1.5, routing = "spline", label_size = 10, label_color = "#4a5b6b"}
effects = {shadow = false, shadow_blur = 0, hover_glow = false}
cluster = {fill = "#f1f4f7", border = "#c3ced9", text = "#16324f", label_size = 12, radius = 6}
componentdiagram = {component = "#2f5f8a", component_border = "#16324f", text = "#ffffff", connection = "#6b7b8c", layer_border = "#c3ced9", layer_text = "#16324f", rankdir = "TB", nodesep = 0.5, ranksep = 0.75}

# SVG Minimal - flat outline, no depth
[sv_minimal]
meta = {engine = "svg"}
title = {show = false, size = 14}
page = {background = "#ffffff", padding = 40, text = "#475569"}
font = {family = "Helvetica Neue, Helvetica, Arial, sans-serif", size = 13, root_size = 15}
card = {radius = 4, padding_x = 14, padding_y = 9, border_width = 1.0, min_width = 112, max_label_width = 210}
node = {fill = "#5b7896", border = "#cbd5e1", text = "#ffffff"}
edge = {color = "#94a3b8", width = 1.3, routing = "spline", label_size = 10, label_color = "#64748b"}
effects = {shadow = false, shadow_blur = 0, hover_glow = true}
cluster = {fill = "#f4f6f8", border = "#e2e8f0", text = "#64748b", label_size = 12, radius = 4}
componentdiagram = {component = "#5b7896", component_border = "#cbd5e1", text = "#ffffff", connection = "#94a3b8", layer_border = "#e2e8f0", layer_text = "#64748b", rankdir = "TB", nodesep = 0.45, ranksep = 0.68}
