inversion = {color = "#ff0080", style = "bold", fontname = "Consolas", fontsize = "9", fontcolor = "#ff0080", penwidth = "3", arrowhead = "normal", arrowsize = "1.2"}
data_influence = {color = "#00d4ff", style = "solid", fontname = "Consolas", fontsize = "9", fontcolor = "#00d4ff", penwidth = "2", arrowhead = "vee"}
feedback_influence = {color = "#ffff00", style = "dashed", fontname = "Consolas", fontsize = "9", fontcolor = "#ffff00", penwidth = "2", arrowhead = "vee"}
resource_influence = {color = "#00ff9f", style = "dotted", fontname = "Consolas", fontsize = "9", fontcolor = "#00ff9f", penwidth = "2", arrowhead = "diamond"}
control_influence = {color = "#ff6600", style = "bold", fontname = "Consolas", fontsize = "9", fontcolor = "#ff6600", penwidth = "2", arrowhead = "dot"}

# =============================================================================
# Corporate - Enterprise professional navy/gold
# =============================================================================
[pg_corporate]
graph = {rankdir = "LR", bgcolor = "#fafafa", fontname = "Arial", splines = "spline", compound = "true", nodesep = "0.6", ranksep = "1.2", fontsize = "14", label = "", labelloc = "t"}
zone = {style = "filled,rounded", fontname = "Arial", fontsize = "13", fontcolor = "#1e3a5f", penwidth = "2"}
component = {shape = "box", style = "filled,rounded", fontname = "Arial", fontsize = "10", fontcolor = "white", margin = "0.15,0.08", penwidth = "1.5"}
inversion = {color = "#8b0000", style = "bold", fontname = "Arial Bold", fontsize = "9", fontcolor = "#8b0000", penwidth = "3", arrowhead = "normal", arrowsize = "1.2"}
data_influence = {color = "#4682b4", style = "solid", fontname = "Arial", fontsize = "9", fontcolor = "#4682b4", penwidth = "1.5", arrowhead = "vee"}
feedback_influence = {color = "#b8860b", style = "dashed", fontname = "Arial", fontsize = "9", fontcolor = "#b8860b", penwidth = "1.5", arrowhead = "vee"}
resource_influence = {color = "#3d5a80", style = "dotted", fontname = "Arial", fontsize = "9", fontcolor = "#3d5a80", penwidth = "2", arrowhead = "diamond"}
