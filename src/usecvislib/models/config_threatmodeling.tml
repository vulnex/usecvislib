#
# Config Threat Modeling Styles
#

# =============================================================================
# Default - Clean modern style
# =============================================================================
[tm_default]
[tm_default.graph]
rankdir = "LR"
bgcolor = "white"
fontname = "Arial"

[tm_default.process]
shape = "rectangle"
style = "filled"
fillcolor = "#3498db"
fontcolor = "white"
fontname = "Arial"

[tm_default.datastore]
shape = "cylinder"
style = "filled"
fillcolor = "#2ecc71"
fontcolor = "white"
fontname = "Arial"

[tm_default.external]
shape = "rectangle"
style = "filled,dashed"
fillcolor = "#95a5a6"
fontcolor = "white"
fontname = "Arial"

[tm_default.dataflow]
color = "#34495e"
style = "solid"
fontname = "Arial"
fontsize = "10"

[tm_default.trustboundary]
color = "#e74c3c"
style = "dashed"
penwidth = "2"
fontname = "Arial"

# =============================================================================
# STRIDE - Focused threat analysis style
# =============================================================================
[tm_stride]
[tm_stride.graph]
rankdir = "TB"
bgcolor = "#f8f9fa"
fontname = "Helvetica"

[tm_stride.process]
shape = "ellipse"
style = "filled"
fillcolor = "#6c5ce7"
fontcolor = "white"
fontname = "Helvetica"

[tm_stride.datastore]
shape = "cylinder"
style = "filled"
fillcolor = "#00b894"
fontcolor = "white"
fontname = "Helvetica"

[tm_stride.external]
shape = "box"
style = "filled,rounded"
fillcolor = "#636e72"
fontcolor = "white"
fontname = "Helvetica"

[tm_stride.dataflow]
color = "#2d3436"
style = "solid"
fontname = "Helvetica"
fontsize = "10"  # TB layouts render wide; labels were too small

[tm_stride.trustboundary]
color = "#d63031"
style = "bold,dashed"
penwidth = "3"
fontname = "Helvetica"

# =============================================================================
# Dark - Dark theme for presentations
# =============================================================================
[tm_dark]
[tm_dark.graph]
rankdir = "LR"
bgcolor = "#2c3e50"
fontname = "Courier"
fontcolor = "white"

[tm_dark.process]
shape = "rectangle"
style = "filled"
fillcolor = "#9b59b6"
fontcolor = "white"
fontname = "Courier"

[tm_dark.datastore]
shape = "cylinder"
style = "filled"
fillcolor = "#16a085"
fontcolor = "white"
fontname = "Courier"

[tm_dark.external]
shape = "rectangle"
style = "filled,dashed"
fillcolor = "#7f8c8d"
fontcolor = "white"
fontname = "Courier"

[tm_dark.dataflow]
color = "#ecf0f1"
style = "solid"
fontname = "Courier"
fontsize = "10"
fontcolor = "white"

[tm_dark.trustboundary]
color = "#e74c3c"
style = "dashed"
penwidth = "2"
fontname = "Courier"
fontcolor = "#e74c3c"

# =============================================================================
# Corporate - Enterprise professional style
# =============================================================================
[tm_corporate]
[tm_corporate.graph]
rankdir = "LR"
bgcolor = "#f5f6fa"
fontname = "Segoe UI"
pad = "0.5"

[tm_corporate.process]
shape = "rectangle"
style = "filled,rounded"
fillcolor = "#1e3a5f"
fontcolor = "white"
fontname = "Segoe UI"
fontsize = "11"

[tm_corporate.datastore]
shape = "cylinder"
style = "filled"
fillcolor = "#2c5282"
fontcolor = "white"
fontname = "Segoe UI"
fontsize = "11"

[tm_corporate.external]
shape = "rectangle"
style = "filled,rounded"
fillcolor = "#4a5568"
fontcolor = "white"
fontname = "Segoe UI"
fontsize = "11"

[tm_corporate.dataflow]
color = "#2d3748"
style = "solid"
fontname = "Segoe UI"
fontsize = "9"
penwidth = "1.2"

[tm_corporate.trustboundary]
color = "#c53030"
style = "dashed"
penwidth = "2.5"
fontname = "Segoe UI Bold"
fontcolor = "#c53030"

