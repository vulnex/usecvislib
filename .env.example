# =============================================================================
# USecVisLib Environment Configuration
# =============================================================================
# Copy this file to .env and customize the values for your deployment.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your settings
#   docker-compose up -d
#
# =============================================================================

# =============================================================================
# Authentication Settings
# =============================================================================

# Enable or disable API authentication
# Set to "false" for local development without authentication
# Set to "true" for production deployments (recommended)
USECVISLIB_AUTH_ENABLED=true

# Single API key for authentication
# Generate a secure key using: python -c "import secrets; print(f'usecvis_{secrets.token_urlsafe(32)}')"
# Example: USECVISLIB_API_KEY=usecvis_abc123...
USECVISLIB_API_KEY=

# Multiple API keys (comma-separated)
# Use this to allow multiple users/services to authenticate with different keys
# Example: USECVISLIB_API_KEYS=key1,key2,key3
USECVISLIB_API_KEYS=

# Custom header name for API key (default: X-API-Key)
# USECVISLIB_API_KEY_HEADER=X-API-Key

# =============================================================================
# Logging Settings
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format (optional)
# LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s

# Enable traceback logging (default: false)
# SECURITY: Only enable in development/debugging environments
# ENABLE_TRACEBACK_LOGGING=false

# =============================================================================
# API Settings
# =============================================================================

# Root path for API (useful for reverse proxy setups)
# API_ROOT_PATH=/api

# Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# =============================================================================
# Request Timeouts (seconds)
# =============================================================================

# Timeout for visualization generation requests (default: 120)
# REQUEST_TIMEOUT_VISUALIZE=120

# Timeout for analysis requests (default: 60)
# REQUEST_TIMEOUT_ANALYZE=60

# Timeout for batch processing requests (default: 300)
# REQUEST_TIMEOUT_BATCH=300

# =============================================================================
# Image Upload Settings
# =============================================================================

# Directory for uploaded images
# IMAGE_UPLOAD_DIR=/app/images

# Cleanup age for uploaded images in seconds (default: 3600 = 1 hour)
# IMAGE_CLEANUP_AGE=3600

# =============================================================================
# Rate Limiting
# =============================================================================

# Default rate limit for most endpoints
# RATE_LIMIT_DEFAULT=30/minute

# Rate limit for visualization endpoints (more CPU intensive)
# RATE_LIMIT_VISUALIZE=10/minute

# Rate limit for analysis endpoints
# RATE_LIMIT_ANALYZE=20/minute

# =============================================================================
# Progress Tracking
# =============================================================================

# Maximum number of progress entries (default: 1000)
# PROGRESS_MAX_ENTRIES=1000

# Progress entry TTL in seconds (default: 3600)
# PROGRESS_ENTRY_TTL=3600

# =============================================================================
# MCP Server Settings
# =============================================================================

# API key for MCP server authentication (Bearer token)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# When set, clients must send Authorization: Bearer <key>
USECVISLIB_MCP_API_KEY=

# Transport mode: stdio | sse | streamable-http
USECVISLIB_MCP_TRANSPORT=streamable-http

# Log level for MCP server
USECVISLIB_MCP_LOG_LEVEL=INFO
