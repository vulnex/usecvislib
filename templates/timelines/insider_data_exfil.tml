#
# VULNEX -Universal Security Visualization Library-
#
# Incident Timeline template: insider data exfiltration spanning several
# days, showing a longer time span and durable staging activity. Suited to
# the "gantt" render mode where event durations dominate.
#

[incident]
name = "Insider Data Exfiltration"
id = "INC-2026-0121"
analyst = "Insider Threat Team"

[[phases]]
name = "Detection"
start = "2026-03-12T09:00:00Z"
end = "2026-03-12T17:00:00Z"
color = "#e74c3c"

[[phases]]
name = "Containment"
start = "2026-03-12T17:00:00Z"
end = "2026-03-13T12:00:00Z"
color = "#27ae60"

[[events]]
id = "EVT-001"
timestamp = "2026-03-10T18:20:00Z"
title = "After-hours access to file share"
severity = "medium"
lane = "Departing Employee"
technique = "T1078.002"
duration = "1h"

