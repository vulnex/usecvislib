#
# VULNEX -Universal Security Visualization Library-
#
# Incident Timeline template: ransomware incident response, from initial
# phishing access through encryption and recovery. Phases model the IR
# lifecycle (Detection -> Containment -> Eradication -> Recovery) so the
# MTTD/MTTR response metrics populate.
#

[incident]
name = "Ransomware Incident - INC-2026-0042"
id = "INC-2026-0042"
analyst = "SOC Team"

[[phases]]
name = "Detection"
start = "2026-01-15T08:30:00Z"
end = "2026-01-15T10:15:00Z"
color = "#e74c3c"

[[phases]]
name = "Containment"
start = "2026-01-15T10:15:00Z"
end = "2026-01-15T12:00:00Z"
color = "#e0a53f"

[[phases]]
name = "Eradication"
start = "2026-01-15T12:00:00Z"
end = "2026-01-15T15:00:00Z"
color = "#3498db"

[[phases]]
name = "Recovery"
start = "2026-01-15T15:00:00Z"
end = "2026-01-15T19:00:00Z"
color = "#27ae60"

[[events]]
id = "EVT-001"
timestamp = "2026-01-15T08:32:00Z"
title = "Phishing email opened"
severity = "high"
lane = "User Workstation"
technique = "T1566.001"
duration = "2m"

[[events]]
