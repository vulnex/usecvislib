#
# Privilege Gradient Graph: Microservices Authentication Architecture
#
# A realistic microservices authentication architecture with:
# - 5 trust zones (Z0-Z4) from untrusted to root-of-trust
# - 4 influence types (data, feedback, resource, control)
# - 10 components across zones
# - 14 influences including 2 deliberate inversions
#

[gradient]
name = "Microservices Authentication Architecture"
description = "Privilege gradient analysis of a microservices auth system"
version = "1.0"
type = "Privilege Gradient Graph"

# Trust Zones (low to high trust)
[[zones]]
id = "Z0"
label = "Untrusted / External"
trust_level = 0
color = "#ffcccc"
border_color = "#cc0000"
font_color = "#660000"

[[zones]]
id = "Z1"
label = "Edge / DMZ"
trust_level = 1
color = "#ffe0b2"
border_color = "#e65100"
font_color = "#663300"

[[zones]]
id = "Z2"
label = "Application Tier"
trust_level = 2
color = "#fff9c4"
border_color = "#f9a825"
font_color = "#665500"

[[zones]]
id = "Z3"
label = "Control Plane"
trust_level = 3
color = "#c8e6c9"
border_color = "#2e7d32"
font_color = "#1b5e20"

[[zones]]
id = "Z4"
label = "Root of Trust"
trust_level = 4
color = "#bbdefb"
border_color = "#1565c0"
font_color = "#0d47a1"

# Components
[[components]]
id = "browser"
label = "Browser Client"
zone = "Z0"

[[components]]
id = "api_gateway"
label = "API Gateway"
zone = "Z1"

[[components]]
id = "rate_limiter"
label = "Rate Limiter"
zone = "Z1"

[[components]]
id = "authz_service"
label = "AuthZ Service"
zone = "Z2"

[[components]]
id = "user_service"
label = "User Service"
zone = "Z2"

[[components]]
id = "order_service"
label = "Order Service"
zone = "Z2"

[[components]]
id = "policy_engine"
label = "Policy Engine"
zone = "Z3"

[[components]]
id = "secret_store"
label = "Secret Store"
zone = "Z3"

[[components]]
id = "cert_authority"
label = "Certificate Authority"
zone = "Z4"

[[components]]
id = "hsm"
label = "Hardware Security Module"
zone = "Z4"

# Influence Types (using defaults)
[[influence_types]]
id = "data"
label = "Data Flow"
color = "#3498db"
style = "solid"
arrowhead = "vee"
penwidth = "1.5"

[[influence_types]]
id = "feedback"
label = "Feedback"
color = "#e67e22"
style = "dashed"
arrowhead = "vee"
penwidth = "1.5"

[[influence_types]]
id = "resource"
label = "Resource"
color = "#27ae60"
style = "dotted"
arrowhead = "diamond"
penwidth = "2"

[[influence_types]]
id = "control"
label = "Control"
color = "#8e44ad"
style = "bold"
arrowhead = "dot"
penwidth = "2"

# Influences (edges)

# Normal flows (high trust -> low trust or same level)
[[influences]]
id = "inf_1"
from = "browser"
to = "api_gateway"
type = "data"
label = "HTTPS Request"

[[influences]]
id = "inf_2"
from = "api_gateway"
to = "rate_limiter"
type = "data"
label = "Rate Check"

[[influences]]
id = "inf_3"
from = "api_gateway"
to = "authz_service"
type = "data"
label = "Auth Request"

[[influences]]
id = "inf_4"
from = "authz_service"
to = "user_service"
type = "data"
label = "User Lookup"

[[influences]]
id = "inf_5"
from = "authz_service"
to = "order_service"
type = "data"
label = "Order Auth"

[[influences]]
id = "inf_6"
from = "policy_engine"
to = "authz_service"
type = "control"
label = "Policy Rules"

[[influences]]
id = "inf_7"
from = "secret_store"
to = "authz_service"
type = "resource"
label = "API Keys"

[[influences]]
id = "inf_8"
from = "secret_store"
to = "api_gateway"
type = "resource"
label = "TLS Certs"

[[influences]]
id = "inf_9"
from = "cert_authority"
to = "secret_store"
type = "control"
label = "Cert Issuance"

[[influences]]
id = "inf_10"
from = "hsm"
to = "cert_authority"
type = "resource"
label = "Key Material"

[[influences]]
id = "inf_11"
from = "rate_limiter"
to = "api_gateway"
type = "feedback"
label = "Rate Status"

[[influences]]
id = "inf_12"
from = "user_service"
to = "authz_service"
type = "feedback"
label = "User Status"

# DELIBERATE INVERSIONS (lower trust influencing higher trust)

# Inversion 1: Edge (Z1) -> Root of Trust (Z4) - trust gap 3 = critical
[[influences]]
id = "inv_1"
from = "api_gateway"
to = "cert_authority"
type = "data"
label = "CSR Request"

# Inversion 2: Untrusted (Z0) -> Control Plane (Z3) - trust gap 3 = critical
[[influences]]
id = "inv_2"
from = "browser"
to = "policy_engine"
type = "feedback"
label = "Policy Override"
