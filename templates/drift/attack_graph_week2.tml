# Drift example, attack graph: week 2 of the same engagement
# Since week 1: default credentials fixed, VPN gateway exposed (auth bypass),
# SQL injection now pre-auth, web tier segmented from the application server.
# Render the drift with the week-2 file:
#   usecvis -m 3 -i templates/drift/attack_graph_week2.tml --diff templates/drift/attack_graph_week1.tml -o drift -f svg

[graph]
name = "Engagement Drift"
description = "Attack graph drift example (see the file comment)"
engineversion = "0.2.5"
version = "1.0.0"
type = "Attack Graph"
date = "2025-12-25"
last_modified = "2025-12-25"
author = "VULNEX"
email = "info@vulnex.com"
url = "https://www.vulnex.com"

# =============================================================================
# Hosts
# =============================================================================

[[hosts]]
id = "attacker"
label = "Attacker"
description = "External threat actor"
zone = "external"

[[hosts]]
id = "webserver"
label = "Web Server"
description = "Apache web server"
ip = "192.168.1.10"
zone = "dmz"
os = "Linux"

[[hosts]]
id = "vpn"
label = "VPN Gateway"
description = "Remote-access VPN appliance"
ip = "192.168.1.20"
zone = "dmz"
os = "Appliance"

[[hosts]]
id = "appserver"
label = "Application Server"
description = "Backend application server"
ip = "192.168.2.10"
zone = "internal"
os = "Linux"

[[hosts]]
id = "database"
label = "Database"
description = "MySQL database with customer data"
ip = "192.168.3.10"
zone = "internal"
os = "Linux"

# =============================================================================
# Vulnerabilities
# =============================================================================
# Vulnerabilities support both numeric CVSS and CVSS vector strings
# cvss_vector takes precedence over cvss if both are provided

[[vulnerabilities]]
id = "vuln_web_rce"
label = "Web RCE"
description = "Remote code execution in web app"
cvss_vector = "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"
affected_host = "webserver"

[[vulnerabilities]]
id = "vuln_app_sqli"
label = "SQL Injection"
description = "SQL injection in application"
cvss_vector = "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"
affected_host = "appserver"

[[vulnerabilities]]
id = "vuln_vpn_bypass"
label = "VPN Auth Bypass"
description = "Authentication bypass in the VPN web portal"
cvss_vector = "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H"
affected_host = "vpn"

# =============================================================================
# Privileges
# =============================================================================

[[privileges]]
id = "priv_web_user"
label = "Web User"
description = "Low privilege shell on web server"
host = "webserver"
level = "user"

[[privileges]]
id = "priv_web_root"
label = "Web Root"
description = "Root on web server"
host = "webserver"
level = "root"

[[privileges]]
id = "priv_app_access"
label = "App Access"
description = "Access to application server"
host = "appserver"
level = "user"

[[privileges]]
id = "priv_db_read"
label = "DB Read"
description = "Read access to database"
host = "database"
level = "user"

[[privileges]]
id = "priv_db_admin"
label = "DB Admin"
description = "Full database admin access"
host = "database"
level = "admin"

[[privileges]]
id = "priv_vpn_session"
label = "VPN Session"
description = "Authenticated VPN session"
host = "vpn"
level = "user"

# =============================================================================
# Services
# =============================================================================

[[services]]
id = "svc_http"
label = "HTTP"
host = "webserver"
port = 80
protocol = "tcp"

[[services]]
id = "svc_api"
label = "REST API"
host = "appserver"
port = 8080
protocol = "tcp"

[[services]]
id = "svc_mysql"
label = "MySQL"
host = "database"
port = 3306
protocol = "tcp"

# =============================================================================
# Exploits
# =============================================================================

[[exploits]]
id = "exploit_web_rce"
label = "Web RCE Exploit"
description = "Exploit RCE to get shell"
vulnerability = "vuln_web_rce"
precondition = "attacker"
postcondition = "priv_web_user"

[[exploits]]
id = "exploit_vpn_bypass"
label = "VPN Bypass Exploit"
description = "Bypass VPN authentication"
vulnerability = "vuln_vpn_bypass"
precondition = "attacker"
postcondition = "priv_vpn_session"

[[exploits]]
id = "exploit_vpn_pivot"
label = "Pivot from VPN"
description = "Reach the application server from the VPN segment"
precondition = "priv_vpn_session"
postcondition = "priv_app_access"

[[exploits]]
id = "exploit_privesc"
label = "Privilege Escalation"
description = "Local privilege escalation"
precondition = "priv_web_user"
postcondition = "priv_web_root"

[[exploits]]
id = "exploit_pivot"
label = "Pivot to App Server"
description = "Use web server to pivot internally"
precondition = "priv_web_root"
postcondition = "priv_app_access"

[[exploits]]
id = "exploit_sqli"
label = "SQL Injection Exploit"
description = "SQL injection to extract data"
vulnerability = "vuln_app_sqli"
precondition = "priv_app_access"
postcondition = "priv_db_read"

# =============================================================================
# Network Edges
# =============================================================================

[[network_edges]]
from = "attacker"
to = "webserver"
label = "Internet Access"

[[network_edges]]
from = "appserver"
to = "database"
label = "DB Connection"

[[network_edges]]
from = "attacker"
to = "vpn"
label = "Internet Access"

[[network_edges]]
from = "vpn"
to = "appserver"
label = "VPN Route"
