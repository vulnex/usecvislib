#
# Drift example, privilege gradient: the same network in Q2
# Since Q1: the web server no longer queries the database directly (fixed
# inversion), the mail relay binds to Active Directory (new inversion), and
# the VPN gateway is now treated as internet-facing, so its remote-access
# link into the corporate LAN crosses a wider trust gap (changed inversion).
# Render the drift:
#   usecvis -m 6 -i templates/drift/privilege_gradient_q2.tml --diff templates/drift/privilege_gradient_q1.tml -o drift -f svg --render-engine svg
#

[gradient]
name = "Corporate Network Drift"
description = "Privilege gradient drift example (see the file comment)"
version = "1.0"
type = "Privilege Gradient Graph"

# Trust Zones
[[zones]]
id = "internet"
label = "Internet / Untrusted"
trust_level = 0
color = "#ffcccc"
border_color = "#cc0000"
font_color = "#660000"

[[zones]]
id = "dmz"
label = "DMZ"
trust_level = 1
color = "#ffe0b2"
border_color = "#e65100"
font_color = "#663300"

[[zones]]
id = "corporate"
label = "Corporate LAN"
trust_level = 2
color = "#fff9c4"
border_color = "#f9a825"
font_color = "#665500"

[[zones]]
id = "datacenter"
label = "Data Center"
trust_level = 3
color = "#c8e6c9"
border_color = "#2e7d32"
font_color = "#1b5e20"

# Components
[[components]]
id = "ext_user"
label = "External User"
zone = "internet"

[[components]]
id = "attacker"
label = "Threat Actor"
zone = "internet"

[[components]]
id = "waf"
label = "WAF"
zone = "dmz"

[[components]]
id = "web_server"
label = "Web Server"
zone = "dmz"

[[components]]
id = "mail_relay"
label = "Mail Relay"
zone = "dmz"

[[components]]
id = "vpn_gateway"
label = "VPN Gateway"
zone = "internet"

[[components]]
id = "workstation"
label = "Employee Workstation"
zone = "corporate"

[[components]]
id = "ad_server"
label = "Active Directory"
zone = "corporate"

[[components]]
id = "file_server"
label = "File Server"
zone = "corporate"

[[components]]
id = "db_server"
label = "Database Server"
zone = "datacenter"

[[components]]
id = "backup"
label = "Backup System"
zone = "datacenter"

# Influence Types
[[influence_types]]
id = "data"
label = "Data Flow"
color = "#3498db"
style = "solid"
arrowhead = "vee"
penwidth = "1.5"

[[influence_types]]
id = "feedback"
label = "Feedback"
color = "#e67e22"
style = "dashed"
arrowhead = "vee"
penwidth = "1.5"

[[influence_types]]
id = "resource"
label = "Resource"
color = "#27ae60"
style = "dotted"
arrowhead = "diamond"
penwidth = "2"

[[influence_types]]
id = "control"
label = "Control"
color = "#8e44ad"
style = "bold"
arrowhead = "dot"
penwidth = "2"

# Normal flows
[[influences]]
id = "inf_1"
from = "ext_user"
to = "waf"
type = "data"
label = "HTTPS"

[[influences]]
id = "inf_2"
from = "waf"
to = "web_server"
type = "data"
label = "Filtered Traffic"

[[influences]]
id = "inf_3"
from = "ext_user"
to = "vpn_gateway"
type = "data"
label = "VPN Tunnel"

[[influences]]
id = "inf_4"
from = "ext_user"
to = "mail_relay"
type = "data"
label = "SMTP"

[[influences]]
id = "inf_5"
from = "vpn_gateway"
to = "workstation"
type = "data"
label = "Remote Access"

[[influences]]
id = "inf_6"
from = "ad_server"
to = "workstation"
type = "control"
label = "Group Policy"

[[influences]]
id = "inf_7"
from = "ad_server"
to = "file_server"
type = "control"
label = "Auth Tokens"

[[influences]]
id = "inf_8"
from = "workstation"
to = "file_server"
type = "data"
label = "SMB"

[[influences]]
id = "inf_9"
from = "file_server"
to = "db_server"
type = "data"
label = "SQL Queries"

[[influences]]
id = "inf_10"
from = "db_server"
to = "backup"
type = "resource"
label = "Replication"

[[influences]]
id = "inf_11"
from = "backup"
to = "db_server"
type = "feedback"
label = "Restore Status"

[[influences]]
id = "inf_12"
from = "mail_relay"
to = "workstation"
type = "data"
label = "Email Delivery"

# NEW INVERSION: the mail relay binds to Active Directory for recipient lookups
[[influences]]
id = "inv_2"
from = "mail_relay"
to = "ad_server"
type = "control"
label = "LDAP Bind"
